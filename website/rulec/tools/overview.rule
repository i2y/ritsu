# The table on the front page's opening diagram (tools/make_overview.py).
# Its last row is the one the picture shows as missing: without that row,
# rulec check reports the witness the picture shows; with it, rulec gen
# writes the code on the right-hand sheet. The amount in that row is a
# placeholder, which is the point - the tool never invents one.
#
# The weights are the same numbers as overview-ja.rule, because the two
# languages draw the same boxes on the same plane; only the words differ.

rule fee v1

enum zone = domestic "Domestic" | overseas "Overseas"

inputs
  destination : zone
  weight      : mass[g]  range >=1g <=10kg

outputs
  fee : money[USD, incl_tax]  round up(1USD)

table fee_table
policy unique
| destination | weight     | -> fee |
| domestic    | <=2kg      | 8USD   |
| domestic    | >2kg <=5kg | 10USD  |
| domestic    | >5kg       | 13USD  |
| overseas    | <=2kg      | 12USD  |
| overseas    | >5kg       | 20USD  |
| overseas    | >2kg <=5kg | 15USD  |
