context Warehouse(warehouse) v1
description "Holds the stock on the shelves, and holds what an order takes until it ships"
owner "the warehouse team"

owns
  dir "../warehouse"
  sekisho "../gates/warehouse.gate"

published language warehouse.v1
  openapi "../warehouse/api/warehouse.json"
  open host service getOrder, requestShipment, requestCancellation

partnership with Ordering
