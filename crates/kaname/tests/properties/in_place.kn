module in_place v1
description "A module with a property and its proof beside it, which the package written for Lean builds where it is"

fn twice(x: number range >=0 <=1000) -> number total
  x + x

property twice_is_even(x: number range >=0 <=1000)
  description "Twice a number leaves nothing over when halved"
  mod(twice(x: x), 2) = 0
