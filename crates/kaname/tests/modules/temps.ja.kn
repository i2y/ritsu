module 温度と零より下の定数(temps_ja) v1
description "温度を、もう一方の単位の零点で読む。零より下の定数は、どの単位でも書ける。定数を、その単位でも、もう一方の単位でも比べ、let に入れ、`in` でもう一方の単位に換算し、引数に渡し、フィールドに入れ、match で分ける。値は `in` でもう一方の単位に換算してから、比べ、丸める。零より下の音の大きさ、金額、長さも並べる。temps.kn の日本語の版"

record 測定(Reading)
  温度(at)    : temperature[℃]  range >=-60℃ <=60℃
  場所(where) : string

# 定数を、もう一方の単位の零点で読み替える。30℃ は 86℉、50℉ は 10℃
fn 暑い(hot)(温度(t): temperature[℉] range >=-40℉ <=140℉) -> string
  if 温度 >= 30℃
    "暑い"
  else
    "暑くない"

fn 涼しい(cool)(温度(t): temperature[℃] range >=-40℃ <=40℃) -> string
  if 温度 < 50℉
    "涼しい"
  else
    "涼しくない"

# let に入れた定数も、比べるところでもう一方の単位に読み替える
fn 基準と比べて暑い(hot_by_line)(温度(t): temperature[℉] range >=-40℉ <=140℉) -> string
  let 基準 = 30℃
  if 温度 >= 基準
    "暑い"
  else
    "暑くない"

# 値を、もう一方の単位の零点で読み替える。0℃ は 32℉、37℃ は 98.6℉、100℉ は 37.8℃
fn 華氏(in_fahrenheit)(温度(t): temperature[℃] range >=-40℃ <=40℃) -> temperature[℉]
  half_up(温度 in ℉, 1℉)

fn 摂氏(in_celsius)(温度(t): temperature[℉] range >=-40℉ <=104℉) -> temperature[℃]
  half_even(温度 in ℃, 1℃)

# 値をもう一方の単位に換算してから比べる。38℃ は 100.4℉
fn 熱がある(feverish)(体温(t): temperature[℃] range >=30℃ <=45℃) -> string
  if 体温 in ℉ > 100℉
    "熱がある"
  else
    "熱はない"

# 定数を `in` でもう一方の単位に換算する。100℃ は 212℉。20℃ in ℉ は 68℉ で、℃ の値と比べるときは
# 20℃ に戻して読む
fn 沸点(boiling)() -> temperature[℉]
  100℃ in ℉

fn 暖かい(warm)(温度(t): temperature[℃] range >=-40℃ <=40℃) -> string
  if 温度 >= 20℃ in ℉
    "暖かい"
  else
    "暖かくない"

# `in` で換算すると二つの整数のあいだに来る定数を丸める。99℉ は 37.2℃
fn 発熱の目安(fever_line)() -> temperature[℃]
  half_up(99℉ in ℃, 1℃)

# もう一方の単位の定数を、引数に渡し、フィールドに入れ、二つの値の大きいほうを選ぶのに使う。41℉ は
# 5℃、77℉ は 25℃、14℉ は -10℃
fn 冷蔵庫(fridge)() -> string
  涼しい(温度: 41℉)

fn 測った値(reading)() -> 測定
  測定 { 温度: 77℉, 場所: "玄関先" }

fn 下限(floor_of)(測定値(r): 測定) -> temperature[℃]
  max(測定値.温度, 14℉)

# 零下のしきい値。値と同じ単位で比べる
fn 凍っている(frozen)(温度(t): temperature[℃] range >=-40℃ <=40℃) -> bool
  温度 <= -18℃

# 零下の定数を、もう一方の単位の零点で読み替える。-20℃ は -4℉、-4℉ は -20℃
fn 冷凍の基準(deep_frozen)(温度(t): temperature[℉] range >=-40℉ <=104℉) -> string
  if 温度 <= -20℃
    "冷凍"
  else
    "基準より上"

fn 下回る(below)(温度(t): temperature[℃] range >=-40℃ <=40℃) -> string
  if 温度 < -4℉
    "下回る"
  else
    "下回らない"

# 零下の定数を、`in` でもう一方の単位に換算する
fn 冷凍庫の上限(freezer_limit)() -> temperature[℉]
  -20℃ in ℉

# 零下の定数を、引数に渡し、フィールドに入れ、二つの値の大きいほうに使う
fn 一番寒い(coldest)() -> bool
  凍っている(温度: -40℃)

fn 冷凍庫で測った値(freezer_reading)() -> 測定
  測定 { 温度: -25℃, 場所: "冷凍庫" }

fn 零下の下限(floor_below_zero)(測定値(r): 測定) -> temperature[℃]
  max(測定値.温度, -40℃)

# match の零下のリテラル
fn 印(mark)(温度(t): temperature[℃] range >=-40℃ <=40℃) -> string
  match 温度
    -18℃ => "基準の線"
    -40℃ => "下限"
    else => "そのほか"

# 零より下の音の大きさ、セントで読む零より下の金額、センチメートルで読む零より下の長さ
fn 静か(quiet)(音(level): sound[dB] range >=-20dB <=140dB) -> string
  if 音 < -10dB
    "聞こえない"
  else
    "聞こえる"

fn 未払い(owed)(残高(balance): money[USDc] range >=-1_000_000USDc <=1_000_000USDc) -> string
  if 残高 <= -1USD
    "未払い"
  else
    "精算済み"

fn 沈んだ(sunk)(深さ(depth): length[cm] range >=-10_000cm <=10_000cm) -> string
  if 深さ < -2m
    "水の下"
  else
    "水面の近く"

examples
  暑い(温度: 86℉) = "暑い"
  暑い(温度: 85℉) = "暑くない"
  涼しい(温度: 9℃) = "涼しい"
  涼しい(温度: 10℃) = "涼しくない"
  基準と比べて暑い(温度: 86℉) = "暑い"
  基準と比べて暑い(温度: 85℉) = "暑くない"
  華氏(温度: 0℃) = 32℉
  華氏(温度: 37℃) = 99℉
  華氏(温度: -40℃) = -40℉
  華氏(温度: -18℃) = 0℉
  摂氏(温度: 32℉) = 0℃
  摂氏(温度: 100℉) = 38℃
  摂氏(温度: -4℉) = -20℃
  熱がある(体温: 38℃) = "熱がある"
  熱がある(体温: 37℃) = "熱はない"
  沸点() = 212℉
  暖かい(温度: 20℃) = "暖かい"
  暖かい(温度: 19℃) = "暖かくない"
  発熱の目安() = 37℃
  冷蔵庫() = "涼しい"
  下限(測定値: 測定 { 温度: 5℃, 場所: "冷蔵庫" }) = 5℃
  凍っている(温度: -20℃) = true
  凍っている(温度: -18℃) = true
  凍っている(温度: -17℃) = false
  冷凍の基準(温度: -4℉) = "冷凍"
  冷凍の基準(温度: -3℉) = "基準より上"
  下回る(温度: -21℃) = "下回る"
  下回る(温度: -20℃) = "下回らない"
  冷凍庫の上限() = -4℉
  一番寒い() = true
  零下の下限(測定値: 測定 { 温度: -50℃, 場所: "屋外" }) = -40℃
  印(温度: -18℃) = "基準の線"
  静か(音: -15dB) = "聞こえない"
  未払い(残高: -100USDc) = "未払い"
  沈んだ(深さ: -201cm) = "水の下"
