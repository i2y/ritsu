# 手元のモジュールの会計。lib の規則と帳簿とモジュールを `@lib/…` で指す。その規則は base の税率を準用
# する。このモジュールは base を require していないので、そのファイルは `@lib/@base/…` として読む。
module かご(basket) v1
description "かごの小計と、モジュール lib の規則「注文の合計」による合計と、かごの注文の請求"

use rule 注文の合計 from "@lib/規則/注文の合計.rule"
use book 台帳 from "@lib/帳簿/台帳.book"
use module 請求 from "@lib/会計/請求.kn"

record 明細(Line)
  品番(sku)        : string
  数(qty)          : number  range >=1 <=10
  単価(unit_price) : money[GBPc]  range >=1GBPc <=10_000GBPc

fn 小計(subtotal)(明細(lines): list[明細] count >=1 <=20) -> money[GBPc]
  sum(明細, m => m.単価 × m.数)

fn 合計(total)(明細(lines): list[明細] count >=1 <=20, 区分(category): 注文の合計.区分, 送料(shipping): money[GBPc] range >=0GBPc <=10_000GBPc) -> money[GBPc] total
  description "かごの小計と区分と送料に対する、規則の合計"
  注文の合計(小計: 小計(明細: 明細), 区分: 区分, 送料: 送料).合計

fn 請求する(charge)(注文(order): string, 明細(lines): list[明細] count >=1 <=20, 区分(category): 注文の合計.区分) -> 台帳.請求.do
  description "かごの注文の請求。送料は無し"
  請求.請求する(注文: 注文, 小計: 小計(明細: 明細), 区分: 区分, 送料: 0GBPc)

examples
  小計(明細: [明細 { 品番: "紅茶", 数: 2, 単価: 450GBPc }, 明細 { 品番: "本", 数: 1, 単価: 1200GBPc }]) = 2100GBPc
  合計(明細: [明細 { 品番: "本", 数: 1, 単価: 1000GBPc }], 区分: 注文の合計.区分.標準, 送料: 395GBPc) = 1595GBPc
  請求する(注文: "o_1", 明細: [明細 { 品番: "本", 数: 1, 単価: 1000GBPc }], 区分: 注文の合計.区分.ゼロ) = 台帳.請求.do(注文: "o_1", 金額: 1000GBPc)
