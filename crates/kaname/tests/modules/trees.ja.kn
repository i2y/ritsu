module 木(trees_ja) v1
description "自分を含む型の値：分類の木とその大きさ、深さ、名前、式とその値、部品表とその費用、総称の木とその葉、値を入れ子にした文書、オプショナルな値でつながるリスト、取り分の内訳。木を組み立て、比べ、確かめ、辞書に入れる。trees.kn の日本語の版"

record 分類(Category)
  名前(name)   : string
  子(children) : list[分類]

enum 式(Expr)
  数(num)
    値(value) : number  range >=-1000 <=1000
  和(add)
    左(left)  : 式
    右(right) : 式
  積(mul)
    左(left)  : 式
    右(right) : 式
  反転(neg)
    中身(inner) : 式

record 部品(Part)
  品番(sku)        : string       count >=1 <=12
  数量(qty)        : number       range >=1 <=1000
  単価(unit_cost)  : money[USDc]  range >=0USDc <=100_000USDc
  部品表(parts)    : list[部品]   count <=20

enum 木(Tree)[T]
  葉(leaf)
    値(value) : T
  節(node)
    子(children) : list[木[T]]

enum 文書(Doc)
  文字(words)
    文(s) : string
  量(amount)
    数(n) : number  range >=-100 <=100
  配列(array)
    要素(items) : list[文書]
  オブジェクト(object)
    メンバー(members) : list[メンバー]

record メンバー(Member)
  鍵(key)   : string
  値(value) : 文書

record 節点(Node)
  値(value) : number  range >=0 <=9
  次(next)  : 節点?

record 取り分(Share)
  割合(part)  : rate[step 1%]
  内訳(under) : list[取り分]  count <=5

# 木の分類の数：その分類と、下にあるすべての分類
fn 大きさ(size)(分類(c): 分類) -> number
  1 + 分類.子.sum(x => 大きさ(分類: x))

# 上から葉までの道の上で、いちばん多い分類の数
fn 深さ(depth)(分類(c): 分類) -> number
  match 分類.子.max_of(x => 深さ(分類: x))
    none => 1
    some d => d + 1

# 木の名前の一覧。分類の名前を、その下の分類の名前より先に並べる
fn 名前の一覧(names)(分類(c): 分類) -> list[string]
  [分類.名前].concat(分類.子.flat_map(x => 名前の一覧(分類: x)))

# 木に、その名前の分類があるか
fn 含む(has)(分類(c): 分類, 名前(name): string) -> bool
  分類.名前 = 名前 or 分類.子.any(x => 含む(分類: x, 名前: 名前))

# 一つずつ前の分類の下に続く、分類の連なり
fn 連なり(chain)(個数(n): number range >=1 <=50) -> 分類
  if 個数 = 1
    分類 { 名前: "葉", 子: [] }
  else
    分類 { 名前: text(個数), 子: [連なり(個数: 個数 - 1)] }

# 二つの木を、全体で比べる
fn 同じ(same)(一つ目(a): 分類, 二つ目(b): 分類) -> bool
  一つ目 = 二つ目

# 辞書の木ごとの大きさ。鍵はそのまま
fn 大きさの一覧(sizes)(木の一覧(trees): dict[string, 分類] count <=5) -> dict[string, number]
  木の一覧.map_values(c => 大きさ(分類: c))

# いちばん上の分類に名前のある木か、名前の無い理由
fn 名前のある木(named)(分類(c): 分類) -> result[分類, string]
  if 分類.名前.trim() = ""
    err("いちばん上の分類に名前がありません")
  else
    ok(分類)

# 式の値。int64 を超える和と積は失敗する
fn 式の値(value_of)(式(e): 式) -> number
  match 式
    数 n => n.値
    和 a => 式の値(式: a.左) + 式の値(式: a.右)
    積 m => 式の値(式: m.左) * 式の値(式: m.右)
    反転 g => 0 - 式の値(式: g.中身)

# 反転の反転を、どこでも取り除いた式
fn 簡単にする(simplify)(式(e): 式) -> 式
  match 式
    反転 g =>
      match g.中身
        反転 h => 簡単にする(式: h.中身)
        else => 式.反転 { 中身: 簡単にする(式: g.中身) }
    和 a => 式.和 { 左: 簡単にする(式: a.左), 右: 簡単にする(式: a.右) }
    積 m => 式.積 { 左: 簡単にする(式: m.左), 右: 簡単にする(式: m.右) }
    数 n => n

# 数を、リテラルの範囲に収めた式にする
fn 数の式(literal)(個数(n): number range >=0 <=1000) -> 式
  式.数 { 値: 個数 }

# 部品の費用：その部品の単価と数量に、それを作る部品の費用を足したもの
fn 費用(cost)(部品(p): 部品) -> money[USDc]
  部品.単価 * 部品.数量 + 部品.部品表.sum(x => 費用(部品: x))

# 部品表のうち、自分の部品を持たない部品の数
fn 末端の部品の数(pieces)(部品(p): 部品) -> number
  if 部品.部品表.count() = 0
    1
  else
    部品.部品表.sum(x => 末端の部品の数(部品: x))

# 総称の木の葉を、左から並べたもの
fn 葉の一覧(leaves)[T](木(t): 木[T]) -> list[T]
  match 木
    葉 l => [l.値]
    節 n => n.子.flat_map(c => 葉の一覧(木: c))

# 木の葉の数の合計
fn 葉の合計(leaf_sum)(木(t): 木[number]) -> number
  葉の一覧(木: 木).sum(x => x)

# 1 から n までの数を、それぞれ一つの節の下の葉にした木
fn 並べた木(spread)(個数(n): number range >=0 <=20) -> 木[number]
  木.節 { 子: numbers(1, 個数).map(i => 木.葉 { 値: i }) }

# 文書が持つ値の数。文書そのものも数える
fn 値の数(values_in)(文書(d): 文書) -> number
  match 文書
    配列 a => 1 + a.要素.sum(x => 値の数(文書: x))
    オブジェクト o => 1 + o.メンバー.sum(m => 値の数(文書: m.値))
    else => 1

# 文書のオブジェクトの鍵を、どの深さのものも順に並べたもの
fn 鍵の一覧(keys_in)(文書(d): 文書) -> list[string]
  match 文書
    配列 a => a.要素.flat_map(x => 鍵の一覧(文書: x))
    オブジェクト o => o.メンバー.flat_map(m => [m.鍵].concat(鍵の一覧(文書: m.値)))
    else => []

# `次` でつながるリストの長さ
fn 長さ(length)(節点(n): 節点) -> number
  match 節点.次
    none => 1
    some m => 1 + 長さ(節点: m)

# つながるリストの値の合計
fn 値の合計(node_sum)(節点(n): 節点) -> number
  match 節点.次
    none => 節点.値
    some m => 節点.値 + 値の合計(節点: m)

# 取り分の数。その取り分そのものも数える
fn 取り分の数(shares)(取り分(s): 取り分) -> number
  1 + 取り分.内訳.sum(x => 取り分の数(取り分: x))

# 100% を超える割合の取り分をここで作って数える。自分を含む型の値は、呼び出しでは、ホストから入る値の決まり
# （範囲を書かない刻みのある率は 0% から 100%）で確かめず、作るところで確かめる
fn 広い取り分(wide_shares)(割合(p): rate[step 1%] range >=0% <=500%) -> number
  取り分の数(取り分: 取り分 { 割合: 100%, 内訳: [取り分 { 割合: 割合, 内訳: [] }] })

# いちばん上から二段下の分類を、その下の分類と合わせて数えたもの
fn 孫の大きさ(grand)(分類(c): 分類) -> number
  分類.子.sum(x => x.子.sum(y => 大きさ(分類: y)))

examples
  大きさ(分類: 分類 { 名前: "a", 子: [分類 { 名前: "b", 子: [] }, 分類 { 名前: "c", 子: [] }] }) = 3
  深さ(分類: 分類 { 名前: "a", 子: [分類 { 名前: "b", 子: [分類 { 名前: "c", 子: [] }] }] }) = 3
  名前の一覧(分類: 分類 { 名前: "a", 子: [分類 { 名前: "b", 子: [] }, 分類 { 名前: "c", 子: [] }] }) = ["a", "b", "c"]
  大きさ(分類: 連なり(個数: 4)) = 4
  式の値(式: 式.和 { 左: 式.数 { 値: 2 }, 右: 式.積 { 左: 式.数 { 値: 3 }, 右: 式.数 { 値: 4 } } }) = 14
  式の値(式: 簡単にする(式: 式.反転 { 中身: 式.反転 { 中身: 式.数 { 値: 5 } } })) = 5
  費用(部品: 部品 { 品番: "kit", 数量: 2, 単価: 100USDc, 部品表: [部品 { 品番: "bolt", 数量: 4, 単価: 10USDc, 部品表: [] }] }) = 240USDc
  葉の合計(木: 並べた木(個数: 4)) = 10
  長さ(節点: 節点 { 値: 1, 次: 節点 { 値: 2, 次: none } }) = 2
  値の数(文書: 文書.配列 { 要素: [文書.量 { 数: 1 }, 文書.オブジェクト { メンバー: [メンバー { 鍵: "k", 値: 文書.文字 { 文: "v" } }] }] }) = 4
  広い取り分(割合: 500%) = 2
  大きさ(分類: 連なり(個数: 50)) = 50
