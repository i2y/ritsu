# The rates are the test's own: no law is transcribed.
rule vat_rate v1
description "The rate of VAT for a category of goods: standard 20%, reduced 5%, zero 0%. The rates are the test's own"

enum category = standard | reduced | zero

inputs
  category : category

outputs
  rate : rate[step 1%]  round down(1%)

table rate_by_category
policy unique
| category | -> rate : rate[step 1%] |
| standard | 20%                     |
| reduced  | 5%                      |
| zero     | 0%                      |

examples
| category | -> rate |
| standard | 20%     |
| reduced  | 5%      |
| zero     | 0%      |
