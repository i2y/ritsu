module bounds v1

use rule discount_share from "examples/discount_split/rules/discount_share.rule"

# A sum of values whose type says no step: the denominator of a sum is not one of its parts' (1/2 +
# 1/3 is 5/6).
fn thirds(xs: list[number] count >=0 <=3 range >=2 <=3) -> number
  down(sum(xs, x => 1 / x), 1)

# A list read in another unit: each element is held to int64 there.
fn many() -> list[mass[oz]] count >=0 <=3
  [600_000_000_000_000_000lb]

# An upper end that rounds past int64: rounded again from the whole number above it, not below.
fn hundredths(a: number range >=-9_200_000_000_000_000_099 <=-9_200_000_000_000_000_000, b: number range >=98 <=99) -> bool
  let r : rate = a / b
  down(r, 1%) < 0%

# A comparison that reads a constant in the unit of the other side keeps no relation between the two
# names.
fn kept(x: money[USDc] range >=0USDc <=1_000_000USDc) -> money[USDc]?
  let k = 1USD
  if k <= x
    discount_share(discount: 0USDc, before: k, upto: x, total: x).share
  else
    none
