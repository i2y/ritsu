{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Line": {
      "type": "object",
      "required": ["sku", "qty"],
      "properties": {
        "sku": { "type": "string" },
        "qty": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "Product": {
      "type": "object",
      "required": ["price"],
      "properties": {
        "price": { "type": "integer", "minimum": 1, "maximum": 1000, "description": "in cents" }
      }
    }
  }
}
