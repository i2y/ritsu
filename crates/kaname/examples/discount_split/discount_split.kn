module discount_split v1
description "Spreads a discount over the lines of a bill in proportion to their amounts, a line at a time through the rule, so that the shares come to the discount"

use rule discount_share from "rules/discount_share.rule"

record Line
  label  : string
  amount : money[USDc]  range >=1USDc <=10_000_000USDc

record Share
  label : string
  share : money[USDc]

fn split(lines: list[Line] count >=1 <=10, discount: money[USDc] range >=0USDc <=10_000_000USDc) -> list[Share] total
  description "The running totals go to the rule; the last line carries what the rounding leaves"
  map(running_totals(lines, l => l.amount), r =>
    Share { label: r.item.label, share: discount_share(discount: discount, before: r.before, upto: r.upto, total: r.total).share })

# Virginia's Example 3: $10.00 off $50.00 of labor and $100.00 of parts.
examples
  split(lines: [Line { label: "labor", amount: 5000USDc }, Line { label: "parts", amount: 10000USDc }], discount: 1000USDc)
    = [Share { label: "labor", share: 333USDc }, Share { label: "parts", share: 667USDc }]
