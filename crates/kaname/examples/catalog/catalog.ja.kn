module カタログ(catalog_ja) v1
description "カタログの分類の木。分類はそれぞれ品物と下の分類を持つ。品物ごとのパス、品物を一つも持たない分類を除いた木、呼ぶ側が渡す関数で名前を替えた木、渡す関数が分類ごとに選んだものを上から順に集めたもの。catalog.kn の日本語の版"

record 品物(Item)
  品番(sku)   : string
  名前(name)  : string
  価格(price) : money[USDc]  range >=1USDc <=1_000_000USDc

record 分類(Category)
  名前(name)         : string
  品物(items)        : list[品物]
  下の分類(children) : list[分類]

# 品物ごとに、上からの分類の名前を並べたパス（`庭 / 道具 / スコップ`）
fn パス(paths)(分類(c): 分類) -> list[string]
  下のパス(分類: 分類, 上: [])

fn 下のパス(paths_under)(分類(c): 分類, 上(above): list[string]) -> list[string]
  let ここまで = 上.append(分類.名前)
  分類.品物.map(一品 => ここまで.append(一品.名前).join(" / ")).concat(分類.下の分類.flat_map(子 => 下のパス(分類: 子, 上: ここまで)))

# 品物を、その分類にもその下にも一つも持たない分類を除いた木
fn 空を除く(pruned)(分類(c): 分類) -> 分類?
  let 残す = 分類.下の分類.filter_map(子 => 空を除く(分類: 子))
  if 分類.品物.count() = 0 and 残す.count() = 0 then none else 分類 { ..分類, 下の分類: 残す }

# 分類ごとの名前を、渡す関数で替えた木
fn 名前を替える(relabel)(分類(c): 分類, 名付け(label): (string) -> string) -> 分類
  分類 { ..分類, 名前: 名付け(分類.名前), 下の分類: 分類.下の分類.map(子 => 名前を替える(分類: 子, 名付け: 名付け)) }

# ウェブのアドレスに使う形の名前。語をハイフンでつなぎ、小文字にする
fn スラッグにする(slugged)(分類(c): 分類) -> 分類
  名前を替える(分類: 分類, 名付け: 名前 => 名前.words().join("-").lower_ascii())

# 渡す関数が分類ごとに選んだものを、上から順に集めたもの
fn 集める(collect)[T](分類(c): 分類, 選ぶ(pick): (分類) -> list[T]) -> list[T]
  選ぶ(分類).concat(分類.下の分類.flat_map(子 => 集める(分類: 子, 選ぶ: 選ぶ)))

fn 品物の一覧(items)(分類(c): 分類) -> list[品物]
  集める(分類: 分類, 選ぶ: 一つ => 一つ.品物)

fn 名前の一覧(names)(分類(c): 分類) -> list[string]
  集める(分類: 分類, 選ぶ: 一つ => [一つ.名前])

# 木の中でいちばん安い品物。同じ価格なら先のもの
fn いちばん安い品物(cheapest)(分類(c): 分類) -> 品物?
  品物の一覧(分類: 分類).min_by(一品 => 一品.価格)

examples
  パス(分類: 分類 { 名前: "庭", 品物: [], 下の分類: [分類 { 名前: "道具", 品物: [品物 { 品番: "sp-1", 名前: "スコップ", 価格: 1999USDc }], 下の分類: [] }] }) = ["庭 / 道具 / スコップ"]
  空を除く(分類: 分類 { 名前: "庭", 品物: [], 下の分類: [分類 { 名前: "種", 品物: [], 下の分類: [] }] }) = none
  スラッグにする(分類: 分類 { 名前: "Garden Tools", 品物: [], 下の分類: [分類 { 名前: "Hand Trowels", 品物: [], 下の分類: [] }] }) = 分類 { 名前: "garden-tools", 品物: [], 下の分類: [分類 { 名前: "hand-trowels", 品物: [], 下の分類: [] }] }
  名前の一覧(分類: 分類 { 名前: "庭", 品物: [], 下の分類: [分類 { 名前: "道具", 品物: [], 下の分類: [] }, 分類 { 名前: "種", 品物: [], 下の分類: [] }] }) = ["庭", "道具", "種"]
