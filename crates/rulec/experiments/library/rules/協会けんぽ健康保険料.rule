rule 協会けんぽ健康保険料(kyokai_kenpo_premium) v1
description "協会けんぽの健康保険料と子ども・子育て支援金。支部と月分で料率を引き、等級・折半・端数は 健康保険料.rule を準用し、令和8年4月分からの支援金を別の額で出す"

import std/都道府県

source 協会けんぽ = file "../sources/kyoukaikenpo/令和8年度都道府県単位保険料率.html" sha256:dba91a5b4fdbaaa4  # https://www.kyoukaikenpo.or.jp/about/business/insurance_rate/rate_prefectures/r08 を 2026-09-19 に写した
source 保険料額表 = file "../sources/kyoukaikenpo/令和8年3月分からの保険料額表_東京支部.pdf" sha256:1c5abc10951aeb94  # https://www.kyoukaikenpo.or.jp/assets/R8_13tokyo.pdf 同日。率の当て方と端数の注記の出典

inputs
  支部(branch)      : 都道府県
  月分(month)       : date       range >=2026-03-01 <=2027-02-28   # 令和8年度の料率が分かっている月分だけ答える。翌年度の料率が出たら行と範囲を足す
  報酬月額(monthly) : money[円]  range >=0円 <=1000万円
  介護該当(care)    : bool                                          # 介護保険第2号被保険者（40歳から64歳まで）

outputs
  標準報酬月額(std)              : money[円]  round down(1円)
  給与控除額(deduct)             : money[円]  round half_down(1円)  # 健康保険料（介護分を含む）の被保険者負担分。給与から控除するとき
  現金納付額(cash)               : money[円]  round half_up(1円)    # 同じく、現金で納めるとき
  支援金給与控除額(levy_deduct)  : money[円]  round half_down(1円)  # 子ども・子育て支援金の被保険者負担分。給与から控除するとき
  支援金現金納付額(levy_cash)    : money[円]  round half_up(1円)    # 同じく、現金で納めるとき

table 料率表(rates)  @協会けんぽ  # 令和8年度都道府県単位保険料率。令和8年3月分（4月納付分）から
policy unique
| 支部     | -> 健康保険料率(rate) : rate[step 0.01%] |
| 北海道   | 10.28%                                   |
| 青森県   | 9.85%                                    |
| 岩手県   | 9.51%                                    |
| 宮城県   | 10.10%                                   |
| 秋田県   | 10.01%                                   |
| 山形県   | 9.75%                                    |
| 福島県   | 9.50%                                    |
| 茨城県   | 9.52%                                    |
| 栃木県   | 9.82%                                    |
| 群馬県   | 9.68%                                    |
| 埼玉県   | 9.67%                                    |
| 千葉県   | 9.73%                                    |
| 東京都   | 9.85%                                    |
| 神奈川県 | 9.92%                                    |
| 新潟県   | 9.21%                                    |
| 富山県   | 9.59%                                    |
| 石川県   | 9.70%                                    |
| 福井県   | 9.71%                                    |
| 山梨県   | 9.55%                                    |
| 長野県   | 9.63%                                    |
| 岐阜県   | 9.80%                                    |
| 静岡県   | 9.61%                                    |
| 愛知県   | 9.93%                                    |
| 三重県   | 9.77%                                    |
| 滋賀県   | 9.88%                                    |
| 京都府   | 9.89%                                    |
| 大阪府   | 10.13%                                   |
| 兵庫県   | 10.12%                                   |
| 奈良県   | 9.91%                                    |
| 和歌山県 | 10.06%                                   |
| 鳥取県   | 9.86%                                    |
| 島根県   | 9.94%                                    |
| 岡山県   | 10.05%                                   |
| 広島県   | 9.78%                                    |
| 山口県   | 10.15%                                   |
| 徳島県   | 10.24%                                   |
| 香川県   | 10.02%                                   |
| 愛媛県   | 9.98%                                    |
| 高知県   | 10.05%                                   |
| 福岡県   | 10.11%                                   |
| 佐賀県   | 10.55%                                   |
| 長崎県   | 10.06%                                   |
| 熊本県   | 10.08%                                   |
| 大分県   | 10.08%                                   |
| 宮崎県   | 9.77%                                    |
| 鹿児島県 | 10.13%                                   |
| 沖縄県   | 9.44%                                    |

define 介護保険料率(care_rate) : rate[step 0.01%] = 1.62%  @協会けんぽ  # 全国一律。令和8年3月分から

table 支援金率表(levy_rates)  @保険料額表  # 子ども・子育て支援金率は令和8年4月分（5月納付分）から
policy unique
| 月分         | -> 支援金率(levy_rate) : rate[step 0.01%] |
| <=2026-03-31 | 0%                                        |  # 3月分にはまだ無い
| >=2026-04-01 | 0.23%                                     |  # 全国一律

apply 健康保険(kenpo) = "健康保険料.rule" sha256:8a2bf8b5101e367d  # 等級の表、折半、端数の注記①②は健康保険料.rule のまま
  報酬月額 = 報酬月額
  健康保険料率 = 健康保険料率
  介護保険料率 = 介護保険料率
  介護該当 = 介護該当

define 支援金折半額(levy_half) : money[円] = 標準報酬月額 × 支援金率 ÷ 2  @保険料額表  # 支援金の欄も全額と折半額で、端数は注記①②
define 支援金給与控除額(levy_deduct) : money[円] = 支援金折半額
define 支援金現金納付額(levy_cash) : money[円] = 支援金折半額

examples
| 支部   | 月分       | 報酬月額 | 介護該当 | -> 標準報酬月額 | 給与控除額 | 現金納付額 | 支援金給与控除額 | 支援金現金納付額 |
| 東京都 | 2026-04-01 | 60000円  | false    | 58000円         | 2856円     | 2857円     | 67円             | 67円             |  # 保険料額表の 1 等級: 全額 5,713.0、折半 2,856.5。支援金 133.4、折半 66.7
| 東京都 | 2026-03-01 | 60000円  | false    | 58000円         | 2856円     | 2857円     | 0円              | 0円              |  # 3月分には支援金が無い
| 東京都 | 2026-04-01 | 300000円 | true     | 300000円        | 17205円    | 17205円    | 345円            | 345円            |  # 22 等級: 11.47% で全額 34,410.0。支援金 690.0、折半 345.0
| 北海道 | 2026-04-01 | 300000円 | false    | 300000円        | 15420円    | 15420円    | 345円            | 345円            |  # 北海道 10.28%: 全額 30,840.0
