rule walk_answers v1
description "Two tiers a walk works out, read through two applies whose rows take values the walk never gives them (fictional)"

enum tier = basic < silver < gold < platinum
enum mark = skip | pick

elements lines
  flagged : bool

outputs
  fold_credit : money[USD]  round down(1USD)
  top_credit : money[USD]  round down(1USD)

# A flagged line is gold and picked, any other silver and skipped
table grade_by_flag
policy unique
| flagged | -> grade : tier | verdict : mark |
| true    | gold            | pick           |
| false   | silver          | skip           |

# The fold answers gold or silver
fold verdict over lines -> chosen : tier
  pick      -> stop with gold
  skip      -> next
  empty     -> silver
  exhausted -> silver

# The highest grade of the gold lines, or else basic: never silver
max top over lines of grade where grade = gold empty basic

apply by_fold = "tier_first.rule" meaning:4c5a5a77c8f14e12
  tier = chosen
  credit -> fold_credit

apply by_top = "tier_first.rule" meaning:4c5a5a77c8f14e12
  tier = top
  credit -> top_credit
