rule band_child v1
description "The band of an age, the rule named like a value of the band (fictional)"

enum band = child "Child" < adult "Adult"

inputs
  age : number  range >=0 <=120

outputs
  band : band
  adult : bool

table band
| age  | -> band |
| <18  | child   |
| >=18 | adult   |

table adult
| band     | -> adult |
| >=adult  | true     |
| child    | false    |

examples
| age | -> band | adult |
| 0   | child   | false |
| 18  | adult   | true  |
