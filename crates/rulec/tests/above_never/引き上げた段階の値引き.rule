rule 引き上げた段階の値引き(lifted_credit) v1
description "上の表がシルバーかゴールドに引き上げる段階の値引きを、準用で読む"

enum 段階(tier) = 一般(basic) < シルバー(silver) < ゴールド(gold) < プラチナ(platinum)

inputs
  会員(member) : 段階

outputs
  値引き(credit) : money[USD]  round down(1USD)

# 会員を引き上げる先の段階。シルバーかゴールドで、一般にもプラチナにもならない
table 会員ごとの引き上げ(lift_by_member)
policy unique
| 会員       | -> 引き上げ先(lift) : 段階 |
| 一般       | シルバー                   |
| シルバー   | ゴールド                   |
| >=ゴールド | ゴールド                   |

# 元の規則の `一般` の行には当たる値が残らず、`>=シルバー` の行はプラチナにも当たる
apply 引き上げ(lifted) = "段階ごとの値引き.rule" meaning:4c33f31084046678
  段階 = 引き上げ先
  値引き -> 値引き
