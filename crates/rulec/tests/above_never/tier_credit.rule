rule tier_credit v1
description "A credit for a tier: the rule lifted_credit.rule reads with an apply"

enum tier = basic < silver < gold < platinum

inputs
  tier : tier

outputs
  credit : money[USD]  round down(1USD)

table credit_by_tier
policy unique
| tier     | -> credit |
| basic    | 0USD      |
| >=silver | 5USD      |
