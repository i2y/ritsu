rule plain_price v1
description "A parcel's price, which every parcel has, from its weight and whether it is media. A row answers none all the same: `none` under an output that is not optional"

inputs
  weight     : mass[oz]  range >=1oz <=32oz
  media_only : bool

outputs
  price : money[USDc]  round down(1USDc)

table price_of
policy unique
| media_only | weight     | -> price : money[USDc] |
| false      | -          | none                   |
| true       | <=1lb      | 439USDc                |
| true       | >1lb <=2lb | 513USDc                |
