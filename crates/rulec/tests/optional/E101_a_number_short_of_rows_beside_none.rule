rule big_bonus v1
description "Says whether a bonus is big, from a number that may be missing. The table writes a row for a missing bonus and one for less than five: five and above are left out"

inputs
  bonus : number?  range >=0 <=10

outputs
  big : bool

table pick
policy unique
| bonus | -> big : bool |
| none  | false         |
| <5    | false         |
