rule 付け替えた出力(renamed_output) v1
description "準用 読む(read) が持ち込む値引きの識別子は read_credit で、この規則が返す出力の別名と同じ"

enum 段階(tier) = 一般(basic) < シルバー(silver) < ゴールド(gold) < プラチナ(platinum)

inputs
  会員(member) : 段階

outputs
  読んだ値引き(read_credit) : money[USD]  round down(1USD)

apply 読む(read) = "段階の値引き.rule" meaning:019f9f8fe0ff0cab
  段階 = 会員
  値引き -> 読んだ値引き

examples
| 会員     | -> 読んだ値引き |
| 一般     | 0USD            |
| ゴールド | 5USD            |
