rule 並びを通る件数(count_through_a_collection) v1
description "注文の明細の部品の数を、二つの並びを通って数える"

shape 注文(order) = jsonschema "orders.schema.json" "#/$defs/Order"

inputs
  部品の数(parts) : number  range >=0 <=50  from count 注文.lines.parts

outputs
  扱う(handled) : bool

table 扱い(handled_by)
policy unique
| 部品の数 | -> 扱う |
| -        | true    |
