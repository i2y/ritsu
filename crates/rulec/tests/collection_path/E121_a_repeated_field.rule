rule repeated_field v1
description "The category of an order's lines, read through a repeated field of a .proto"

shape order = proto "orders.proto" shop.v1.Order

enum kind = tool | part | service

inputs
  category : kind  from order.lines.category

outputs
  handled : bool

table handled_by
policy unique
| category      | -> handled |
| tool          | true       |
| part, service | false      |
