rule definition_of_a_tier_that_may_be_absent v1
description "A definition that names a tier that may be absent, passed to a rule whose tier is always there"

enum tier = basic < silver < gold < platinum

inputs
  member : tier?

outputs
  credit : money[USD]  round down(1USD)

define repeat_tier : tier? = member

apply tiered = "tier_credit.rule" meaning:0952b859b9828c84
  tier = repeat_tier
  credit -> credit
