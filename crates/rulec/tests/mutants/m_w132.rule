contribution bulk_campaign(bulk_campaign) v1
description "A campaign for bulk orders whose cap of 60 dollars sits above the 50 dollars every order already has, so it caps nothing (W132)"
to "../corpus/order_discount.rule" signature:fe7307da2694d75a

inputs
  bulk(bulk) : bool

table bulk_cap_of
policy unique
| bulk  | -> bulk_cap : money[USD] |
| true  | 60USD                    |
| false | 50USD                    |

into cap
  bulk_cap
