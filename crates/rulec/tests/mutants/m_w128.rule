rule tile_count v1
description "Sorts two square rooms by how many tiles they take together. A row asks the count to be 7, which no two whole sides square and add up to, and neither the vectors nor the check decide it (W128)"

inputs
  side   : number  range >=0 <=10
  second : number  range >=0 <=10

outputs
  size : number  round down(1)

define tiles : number = side * side + second * second

table size_of
policy first
| tiles | -> size : number |
| 7     | 1                |
| <=1   | 0                |
| -     | 2                |
