rule order_fee v1
description "An order's fee, from what the caller has already counted. The caller keeps three combinations out, so the tables have no rows for them. Each is written as a `never` line: the page says so, and every target refuses such a call at the door."

enum tier = basic | gold

inputs
  has_tool  : bool
  all_parts : bool
  tier      : tier
  tools     : number  range >=0 <=5
  total     : money[USD]  range >=0USD <=1000USD

# A truth value cannot go in a `constraint`, and a `gold` order always has a tool.
never has_tool = true, all_parts = true
never tier = gold, tool = 0
never tools = 0, total > 0USD

outputs
  fee : money[USD]  round up(1USD)

table handling
policy unique
| has_tool | all_parts | -> handling_fee : money[USD] |
| true     | false     | 5USD                         |
| false    | true      | 0USD                         |
| false    | false     | 2USD                         |

table by_tier
policy unique
| tier  | tools | -> tier_fee : money[USD] |
| basic | 0     | 0USD                     |
| basic | >=1   | 3USD                     |
| gold  | >=1   | 1USD                     |

table by_total
policy unique
| tools | total    | -> total_fee : money[USD] |
| 0     | 0USD     | 0USD                      |
| >=1   | <=100USD | 4USD                      |
| >=1   | >100USD  | 0USD                      |

define all_fees : money[USD] = handling_fee + tier_fee + total_fee

result fee = all_fees

examples
| has_tool | all_parts | tier  | tools | total  | -> fee |
| true     | false     | gold  | 2     | 50USD  | 10USD  |
| false    | true      | basic | 1     | 500USD | 3USD   |
| false    | false     | basic | 0     | 0USD   | 2USD   |
