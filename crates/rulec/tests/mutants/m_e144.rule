rule shipping v1
description "The fee of an order. The generated code counts the parcels in the contract's list, and hand-written code would not carry the count"

shape order = jsonschema "contracts/order.schema.json" "#/$defs/Order"

inputs
  parcels : number  range >=0 <=100  from count order.parcels  fed by rulec "scale.rule" output parcels

outputs
  fee : number

table fee_of
policy unique
| parcels | -> fee : number |
| <=10    | 5               |
| >10     | 20              |
