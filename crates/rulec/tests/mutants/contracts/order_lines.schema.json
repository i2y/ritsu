{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order with its lines",
  "$defs": {
    "Order": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lines": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/Line" } }
      },
      "required": ["lines"]
    },
    "Line": {
      "type": "object",
      "properties": {
        "sku": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 99 },
        "amount_usd": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "fragile": { "type": "boolean" }
      },
      "required": ["sku", "quantity", "amount_usd", "fragile"]
    }
  }
}
