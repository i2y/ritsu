rule true_fee v1
description "A definition named True, which rulec writes with an underscore after it"

inputs
  qty : number  range >=0 <=10

outputs
  fee : money[USD]  round down(1USD)

define True : money[USD] = 3USD

table fee_by_qty
policy unique
| qty | -> fee |
| <=5 | True   |
| >5  | 2USD   |
