rule walked_fee v1
description "An input named like the name the module gives the builtin its walk counts the elements with"

inputs
  _enumerate : bool

elements lines
  qty : number  range >=1 <=100

sum total over lines of qty  range >=0 <=1_000

outputs
  fee : money[USD]  round down(1USD)

table fee_by_total
policy unique
| _enumerate | total | -> fee |
| true       | <50   | 1USD   |
| true       | >=50  | 2USD   |
| false      | -     | 3USD   |
