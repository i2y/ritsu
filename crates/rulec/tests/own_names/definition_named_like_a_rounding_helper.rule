rule rounded_fee v1
description "A definition named like the helper Rust rounds an output with"

inputs
  qty : number  range >=0 <=10

outputs
  fee : money[USD]  round down(1USD)

define round_down : money[USD] = 3USD

table fee_by_qty
policy unique
| qty | -> fee     |
| <=5 | round_down |
| >5  | 2USD       |
