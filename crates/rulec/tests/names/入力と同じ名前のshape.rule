rule 急ぎと贈り物の料金(rush_gift_fee) v1
description "呼ぶ側がそのまま渡す入力と、同じ識別子の shape"

shape 注文(rush) = jsonschema "orders.schema.json" "#/$defs/Order"

inputs
  贈り物(gift) : bool  from 注文.gift
  急ぎ(rush)   : bool

outputs
  料金(fee) : number  round down(1)

table 急ぎかどうか(by_rush)
policy unique
| 急ぎ  | 贈り物 | -> 料金 |
| true  | -      | 10      |
| false | -      | 5       |
