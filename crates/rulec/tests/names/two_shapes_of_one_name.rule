rule rush_fee v1
description "One shape declared twice, over two contracts"

shape order = jsonschema "orders.schema.json" "#/$defs/Order"
shape order = jsonschema "orders.schema.json" "#/$defs/Return"

inputs
  rush : bool  from order.rush

outputs
  fee : number  round down(1)

table by_rush
policy unique
| rush  | -> fee |
| true  | 10     |
| false | 5      |
