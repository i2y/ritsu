rule markup v1
description "The price of an item: its list price and a markup by kind. The markup is a rate the rule works with and does not answer, held to whole percents on the heading of its table"

enum kind = books | music | toys

inputs
  item_kind  : kind
  list_price : money[USD]  range >=0USD <=1000USD

outputs
  price : money[USD]  round half_up(1USD)

table markup_of
policy unique
| item_kind | -> markup : rate[step 1%] |
| books     | 0.5%                      |
| music     | 10%                       |
| toys      | 20%                       |

define price : money[USD] = list_price + list_price * markup
