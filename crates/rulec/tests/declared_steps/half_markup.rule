rule half_markup v1
description "The price of an item on sale: half the markup by kind. The half markup is typed in whole percents, and half of 5% is 2.5%"

enum kind = books | music | toys

inputs
  item_kind  : kind
  list_price : money[USD]  range >=0USD <=1000USD

outputs
  price : money[USD]  round half_up(1USD)

table markup_of
policy unique
| item_kind | -> markup : rate[step 1%] |
| books     | 5%                        |
| music     | 10%                       |
| toys      | 20%                       |

define sale_markup : rate[step 1%] = markup / 2

define price : money[USD] = list_price + list_price * sale_markup
