rule never_even v1
description "Each wrapped line takes two sheets and the card one more, so the sheets are odd: a range of two sheets takes no call"

# A line of the order
elements lines
  gift : bool

count gifts over lines where gift  range >=0 <=5

define sheets : number = gifts * 2 + 1  range >=2 <=2

outputs
  large_roll : bool

table roll_of
policy unique
| sheets | -> large_roll |
| -      | true          |
