rule passed_member v1
description "The table above passes the member's own tier on from gold up, and the table below takes every tier the table above writes"

enum tier = basic < silver < gold < platinum

inputs
  member : tier

outputs
  credit : money[USD]  round down(1USD)

table lift_by_member
policy unique
| member | -> lift : tier |
| basic  | silver         |
| silver | gold           |
| >=gold | member         |

table credit_by_lift
policy unique
| lift     | -> credit |
| >=silver | 5USD      |

examples
| member   | -> credit |
| basic    | 5USD      |
| platinum | 5USD      |
