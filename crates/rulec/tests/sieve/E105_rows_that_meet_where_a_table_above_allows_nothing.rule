rule refund_check v1
description "Decides how a refund is checked. A refund is small only up to 50 pounds, and the limit is never above the amount, so no small refund has a limit over 60 pounds: the first two rows never meet, and the table is unique as written"

enum size = small | large
enum way = none_needed | by_hand | by_post

inputs
  amount : money[GBP]  range >=1GBP <=100GBP
  limit  : money[GBP]  range >=0GBP <=100GBP

constraint limit <= amount

outputs
  checked : way

table size_of
policy unique
| amount  | -> refund_size : size |
| <=50GBP | small                 |
| >50GBP  | large                 |

table check_of
policy unique
| refund_size | limit   | -> checked : way |
| small       | -       | none_needed      |
| -           | >60GBP  | by_hand          |
| large       | <=60GBP | by_post          |
