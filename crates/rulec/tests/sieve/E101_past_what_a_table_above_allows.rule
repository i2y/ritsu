rule refund_review v1
description "Decides whether a refund is looked at by hand. A refund is small only up to 50 pounds, so a small refund is never more than 50 pounds over the limit, and no row asks for one"

enum size = small | large
enum review = waved | by_hand

inputs
  amount : money[GBP]  range >=1GBP <=100GBP
  limit  : money[GBP]  range >=0GBP <=100GBP

outputs
  decision : review

derive excess : money[GBP] = amount - limit  range >=-100GBP <=100GBP

table size_of
policy unique
| amount  | -> refund_size : size |
| <=50GBP | small                 |
| >50GBP  | large                 |

table decision_of
policy unique
| refund_size | excess         | -> decision : review |
| small       | <=0GBP         | waved                |
| small       | >0GBP <=50GBP  | by_hand              |
| large       | -              | by_hand              |
