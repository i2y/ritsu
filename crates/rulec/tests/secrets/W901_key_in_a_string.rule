rule seats v1
description "How many seats an event of a kind needs. The counts come from the venue's sheet, read with the Google Sheets API key AIzaSyD-ritsu-fake-key-for-tests-000000"

enum kind = workshop | talk

inputs
  event_kind : kind

outputs
  needed : number  round down(1)

table pick
policy unique
| event_kind | -> needed : number |
| workshop   | 30                 |
| talk       | 80                 |
