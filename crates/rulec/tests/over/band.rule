rule band v1
description "The band of an age that may be left out: a value of its own when it is, which no call that gives an age comes to"

enum band = unknown | child | adult
enum seat = standing | seated

inputs
  age  : number?  range >=1 <=100
  seat : seat?

outputs
  band  : band
  place : band

table band_of
policy unique
| age  | -> band |
| none | unknown |
| <13  | child   |
| >=13 | adult   |

table place_of
policy unique
| seat     | -> place |
| none     | unknown  |
| standing | child    |
| seated   | adult    |

examples
| age  | seat     | -> band | place   |
| none | none     | unknown | unknown |
| 6    | standing | child   | child   |
| 30   | seated   | adult   | adult   |
