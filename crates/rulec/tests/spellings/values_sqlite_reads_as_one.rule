rule small_fee v1
description "Two definitions SQLite reads as one column"

inputs
  qty : number  range >=0 <=10

outputs
  fee : money[USD]  round down(1USD)

define afee : money[USD] = 3USD
define aFee : money[USD] = 2USD

table fee_by_qty
policy unique
| qty | -> fee |
| <=5 | afee   |
| >5  | aFee   |
