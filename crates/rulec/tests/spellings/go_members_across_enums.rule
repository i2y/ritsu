rule plan_fee v1
description "Values of two enums whose Go members take one name"

enum plan = gold_plus | basic
enum plan_gold = plus | minus

inputs
  member : plan
  extra  : plan_gold

outputs
  fee : money[USD]  round down(1USD)

table fee_by_plan
policy unique
| member    | extra | -> fee |
| gold_plus | -     | 1USD   |
| basic     | plus  | 2USD   |
| basic     | minus | 3USD   |
