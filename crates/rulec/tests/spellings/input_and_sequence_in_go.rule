rule order_total v1
description "An input and a sequence Go and the .proto spell alike"

inputs
  lines_ : money[USD]  range >=0USD <=10USD

elements lines
  amount : money[USD]  range >=0USD <=100USD

outputs
  total : money[USD]  round down(1USD)

sum spent over lines of amount  range >=0USD <=1000USD

define total : money[USD] = spent + lines_
