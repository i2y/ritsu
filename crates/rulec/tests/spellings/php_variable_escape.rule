rule query_fee v1
description "Two definitions PHP writes as one variable"

inputs
  qty : number  range >=0 <=10

outputs
  fee : money[USD]  round down(1USD)

define _GET : money[USD] = 3USD
define _GET_ : money[USD] = 2USD

table fee_by_qty
policy unique
| qty | -> fee |
| <=5 | _GET   |
| >5  | _GET_  |
