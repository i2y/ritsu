rule course_fee v1
description "Two prerequisites blocks some languages spell alike"

enum course = intro | advanced | capstone

inputs
  taking : course

outputs
  fee : money[USD]  round down(1USD)

table fee_by_course
policy unique
| taking   | -> fee |
| intro    | 1USD   |
| advanced | 2USD   |
| capstone | 3USD   |

prerequisites core__path over course
  start    intro
  advanced requires intro
  capstone requires advanced

prerequisites corePath over course
  start    intro
  advanced requires intro
  capstone requires intro
