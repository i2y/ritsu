rule bands_cut_elsewhere v1
description "A band the table above cuts at 50 yen, read with the amount cut at 80 yen as well: from 51 yen to 80 yen the band is small, and the second row takes those amounts"

enum size = small | large
enum choice = one | two

inputs
  amount : money[JPY]  range >=1JPY <=300JPY

outputs
  x : choice

table band_of
| amount  | -> band : size |
| <=50JPY | large          |
| >50JPY  | small          |

table pick
| amount         | band  | -> x |
| <=50JPY        | large | one  |
| >50JPY <=80JPY | small | two  |
| >80JPY         | small | one  |
