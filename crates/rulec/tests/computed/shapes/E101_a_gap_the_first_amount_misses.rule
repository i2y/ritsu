rule gap_past_the_first_value v1
description "A gap whose first amount gives a fee outside it: the fee passes 1,000 yen only from 33,367 yen, and the example is that amount"

enum verdict = ok | check

inputs
  amount : money[JPY]  range >=1JPY <=600_000JPY

apply f = "shared/fee_band.rule" meaning:bad106738838022d
  amount = amount
  charged -> f_fee

outputs
  v : verdict

table pick
| amount      | f_fee              | -> v  |
| <=30_000JPY | -                  | ok    |
| >30_000JPY  | <=900JPY           | ok    |
| >30_000JPY  | >900JPY <=1_000JPY | check |
