rule unwritten_optional v1
description "An output that may have no value, and that nothing decides"

enum level = low "Low" | high "High"

inputs
  amount : money[JPY]  range >=1JPY <=100_000JPY
  member : bool

outputs
  grade  : level?
  review : bool

table review_of
policy unique
| member | -> review |
| true   | false     |
| false  | true      |
