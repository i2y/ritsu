rule 会員の値引き(member_credit) v1
description "会員自身の段階でキャンペーンを引き上げた段階の値引き"

enum 段階(tier) = 一般(basic) < シルバー(silver) < ゴールド(gold) < プラチナ(platinum)

inputs
  会員(member) : 段階

outputs
  値引き(credit) : money[USD]  round down(1USD)

# 一段上げる。プラチナの会員はプラチナのまま。
table 会員による引き上げ(lift_by_member)
policy unique
| 会員     | -> 引き上げ段階(lift) : 段階 |
| 一般     | シルバー                     |
| シルバー | ゴールド                     |
| ゴールド | ゴールド                     |
| プラチナ | プラチナ                     |

apply 引き上げ(lifted) = "キャンペーンの値引き.rule" meaning:e3f3f3218fbb57dc
  キャンペーン = 引き上げ段階
