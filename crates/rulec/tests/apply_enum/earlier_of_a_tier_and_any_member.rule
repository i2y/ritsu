rule earlier_of_a_tier_and_any_member v1
description "The credit at the earlier of the campaign's tier, held to the campaign's range, and the member's, which may be platinum"

enum tier = basic < silver < gold < platinum

inputs
  campaign_tier : tier  range >=basic <=gold
  member_tier : tier

outputs
  credit : money[USD]  round down(1USD)

# The earlier of the two is never later than the campaign's tier, so never past gold.
define lower : tier = min(campaign_tier, member_tier)

apply lowered = "campaign_credit.rule" meaning:f32dc45b0de51c57
  campaign = lower
