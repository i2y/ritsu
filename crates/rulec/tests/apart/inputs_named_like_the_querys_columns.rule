rule id_fee v1
description "Inputs named like the columns the SQL query hands back beside the answer"

inputs
  _id : number  range >=0 <=10
  _input_error : number  range >=0 <=10  contract_only

outputs
  fee : money[USD]  round down(1USD)

table fee_by_qty
policy unique
| _id | -> fee |
| <=5 | 3USD |
| >5  | 2USD |
