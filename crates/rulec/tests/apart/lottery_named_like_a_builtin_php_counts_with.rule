rule tally(count) v1
description "A rule named like the builtin the PHP function that counts the answers calls, with no sequence"

enum prize = first | second | third | no_prize

inputs
  ticket : number  range >=0 <=999  random
  campaign : bool

outputs
  prize : prize

table numbers
policy unique
| ticket    | campaign | -> prize |
| 0         | -        | first    |
| >=1 <=9   | -        | second   |
| >=10 <=99 | true     | third    |
| >=10 <=59 | false    | third    |
| >=60 <=99 | false    | no_prize |
| >=100     | -        | no_prize |

chances
| campaign | -> prize | chance |
| -        | first    | 0.1%   |
| -        | second   | 0.9%   |
| true     | third    | 9%     |
| false    | third    | 5%     |
| true     | no_prize | 90%    |
| false    | no_prize | 94%    |

examples
| ticket | campaign | -> prize |
| 0      | false    | first    |
| 9      | false    | second   |
| 59     | false    | third    |
| 60     | false    | no_prize |
| 99     | true     | third    |
| 100    | true     | no_prize |
