rule stamp_duty_rows v1
description "The stamp duty on a contract, by the day it is made. The reduced amount is for contracts made up to 31 March 2027, and every day the input allows falls before it, so `reduced` is always true and no input reaches the row for false"

inputs
  made : date  range >=2024-04-01 <=2026-12-31

outputs
  duty : money[JPY]  round down(1JPY)

define reduced : bool = made <= 2027-03-31

table duty_of
policy unique
| reduced | -> duty : money[JPY] |
| true    | 200JPY               |
| false   | 400JPY               |

examples
| made       | -> duty |
| 2025-06-01 | 200JPY  |
