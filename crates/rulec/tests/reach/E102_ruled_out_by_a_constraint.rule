rule return_route v1
description "Where a return goes. No more items come back than were ordered, so the third row, written for more coming back than went out, is reached by no input. Its `-` under the refund lets in what the refund comes to: the constraint leaves the row out, not the refund's reach"

enum route = decline | approve | review

inputs
  paid     : money[GBP]  range >=0GBP <=20GBP
  fee      : money[GBP]  range >=0GBP <=10GBP
  returned : number  range >=0 <=10
  ordered  : number  range >=0 <=10

constraint returned <= ordered

outputs
  outcome : route

derive refund : money[GBP] = paid - fee  range >=-1000GBP <=1000GBP

table route_of
policy first
| refund         | returned | ordered | -> outcome : route |
| <=0GBP         | -        | >=5     | decline            |
| >0GBP <=200GBP | -        | >=5     | approve            |
| -              | >5       | <=5     | review             |
| -              | -        | -       | approve            |
