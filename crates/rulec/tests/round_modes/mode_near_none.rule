rule parcel_fee v1
description "A parcel fee whose rounding mode is written sideways, a word near none of the five"

inputs
  qty : number  range >=1 <=100

outputs
  fee : money[USD]  round sideways(1USD)

define by_qty : money[USD] = qty * 75USD / 100

table fee_by_qty
policy unique
| qty | -> fee |
| <=4 | 3USD   |
| >4  | by_qty |
