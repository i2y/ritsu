rule route(route) v1
description "Where a change goes, from the facts of ritsu impact. Each input is named after a fact. The last table holds the promise: its rows send no change that moved an answer to merge, so a `route` table that does stops the check (E101)"

enum destination(destination) = merge | owner_reads | stop

inputs
  new_errors          : number  range >=0 <=1000000
  new_warnings        : number  range >=0 <=1000000
  undecided           : number  range >=0 <=1000000
  generated_stale     : bool
  generated_unchecked : number  range >=0 <=1000000
  rule_changes        : number  range >=0 <=1000000
  date_changes        : number  range >=0 <=1000000
  allow_gained        : number  range >=0 <=1000000
  allow_lost          : number  range >=0 <=1000000
  policies_moved      : number  range >=0 <=1000000
  book_changes        : number  range >=0 <=1000000
  interface_changes   : number  range >=0 <=1000000
  interface_breaks    : number  range >=0 <=1000000
  requirements_moved  : number  range >=0 <=1000000
  opaque_specs        : number  range >=0 <=1000000
  unclaimed_lines     : number  range >=0 <=1000000
  other_files         : number  range >=0 <=1000000

outputs
  route        : destination
  person_reads : bool

define moved : number = rule_changes + date_changes + allow_gained + allow_lost + policies_moved + book_changes + interface_changes + interface_breaks + requirements_moved
define unread : number = undecided + generated_unchecked + opaque_specs + unclaimed_lines + other_files + new_warnings

table route
policy unique
| generated_stale | new_errors | moved | unread | -> route : destination |
| true            | -          | -     | -      | stop                   |
| false           | >=1        | -     | -      | stop                   |
| false           | 0          | >=1   | -      | owner_reads            |
| false           | 0          | 0     | >=1    | owner_reads            |
| false           | 0          | 0     | 0      | merge                  |

table answers
policy unique
| moved | -> answers_moved : bool |
| >=1   | true                    |
| 0     | false                   |

table who_reads
policy unique
| answers_moved | route             | -> person_reads : bool |
| true          | owner_reads, stop | true                   |
| false         | owner_reads, stop | true                   |
| false         | merge             | false                  |

examples
