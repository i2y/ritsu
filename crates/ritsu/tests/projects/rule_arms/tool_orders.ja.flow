workflow 工具の注文 v1
description "注文の区分について規則が言うとおりに、工具をすぐに出すか先に確かめるかを決め、上位の注文としても規則に聞き直す。通常の注文は工具が三つ以上なら先に確かめるので、数えた結果が三つの実行がそこへ進む。上位の注文は数によらずすぐに出すので、二つめの答えで確かめに回る実行はない。"

use rule 経路の判断 from "rules/工具の経路.rule"

inputs
  注文 : string
  区分 : 経路の判断.区分

task 工具を数える(注文: string) -> int  range >=0 <=5
  idempotent

task 出荷する(注文: string)
  key

task 確かめる(注文: string)
  key

flow
  let 数 = 工具を数える(注文: 注文)
  let 決定 = 経路の判断(工具数: 数, 区分: 区分)
  match 決定.行き先
    すぐ => 出荷する(注文: 注文)
    確認 => 確かめる(注文: 注文)
  let 上位なら = 経路の判断(工具数: 数, 区分: 上位)
  match 上位なら.行き先
    すぐ => pass
    確認 => 確かめる(注文: 注文)
