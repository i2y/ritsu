# Copied from rulec's tests/corpus/決済手数料.rule, with the names in English
rule payment_fee v1
description "The fee of one transaction, from the fee rate each contract sets. An example where the rate is set in steps finer than 1%"

inputs
  amount : money[JPY, incl_tax]  range >=0JPY <=1000000JPY
  rate   : rate[step 0.1%]       range >=0% <=10%
  small  : bool

outputs
  fee : money[JPY, incl_tax]  round up(1JPY)

# The contract's floor: nothing is charged at 0.5% or below (this row can be written because the rate moves in steps of 0.1%)
define rate_fee : money[JPY, incl_tax] = amount × rate

table fee_table
policy unique
| rate   | small | -> fee : money[JPY, incl_tax] |
| <=0.5% | -     | 0JPY                          |
| >0.5%  | true  | 50JPY                         |
| >0.5%  | false | rate_fee                      |

result fee = fee

examples
| amount   | rate | small | -> fee |
| 10000JPY | 0.5% | false | 0JPY   |
| 10000JPY | 0.6% | false | 60JPY  |
| 10000JPY | 3.6% | false | 360JPY |
| 10000JPY | 3.6% | true  | 50JPY  |
