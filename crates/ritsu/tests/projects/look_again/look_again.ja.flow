workflow 見直し v1
description "入金済の注文の取消を頼み、倉庫が取消を拒んだら、注文をもう一度見て、どの状態かを言う。注文の状態は倉庫が持ち、その移り方は規則「注文の状態」に従う。入金済の注文の取消が拒まれるのは、途中ですでに取り消されていたときだけ"

use rule 注文の状態 from "rules/注文の状態.rule"

record 注文
  id   : string
  状態 : 注文の状態.状態

inputs
  注文ID : string

outputs
  状態 : 注文の状態.状態

task 注文を見る(id: string) -> 注文
  http GET "https://warehouse.example.com/v1/orders/{id}"
  observes
  idempotent

task 取消を頼む(id: string) -> 注文
  http POST "https://warehouse.example.com/v1/orders/{id}/cancellations"
  sends 取消依頼
  errors 拒否された = 409
  refused as 拒否された
  key

case 受注 : 注文 follows 注文の状態.注文
  external 入金, 配達, 取消依頼
  refused when 受理 = false

flow
  受注 <- 注文を見る(id: 注文ID)
  match 受注.状態
    入金済 =>
      受注 <- 取消を頼む(id: 受注.id)
        on 拒否された =>
          受注 <- 注文を見る(id: 受注.id)
          fail NotCancelled "注文 {受注.id} は、この依頼では取り消されませんでした。今は {受注.状態} です"
        on failure => fail CancelFailed "注文 {受注.id} を取り消せませんでした" leaving 受注
    受付, 出荷済, 配達済, 取消 => fail NotPaid "注文 {受注.id} は入金されていません" leaving 受注
  succeed 状態 = 受注.状態
