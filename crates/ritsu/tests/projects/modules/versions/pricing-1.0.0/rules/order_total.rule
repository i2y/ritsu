# The total of an order: the VAT is the subtotal at the rate the rule of the module tax gives for
# the category, which this rule applies by `@tax/…`, a path from the root of this module.
rule order_total v1
description "The total of an order: its subtotal, the VAT of its category at the rate of the rule vat_rate of the module tax, and the shipping fee"

enum category = standard | reduced | zero

inputs
  subtotal : money[GBPc]  range >=0GBPc <=2_000_000GBPc
  category : category
  shipping : money[GBPc]  range >=0GBPc <=10_000GBPc

outputs
  total : money[GBPc]  round half_up(1GBPc)

apply vat = "@tax/rules/vat_rate.rule" meaning:8a62fb4ec05fd289
  category = category
  rate -> vat_rate

result total = subtotal + subtotal * vat_rate + shipping

examples
| subtotal | category | shipping | -> total |
| 1000GBPc | standard | 395GBPc  | 1595GBPc |
| 1000GBPc | reduced  | 395GBPc  | 1445GBPc |
| 999GBPc  | reduced  | 0GBPc    | 1049GBPc |
| 1000GBPc | zero     | 0GBPc    | 1000GBPc |
