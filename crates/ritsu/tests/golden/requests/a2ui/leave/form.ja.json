                    "@path": "/ticket/id"
                  },
                  "revision": {
                    "@path": "/ticket/revision"
                  },
                  "comment": {
                    "@call": "comment",
                    "catalogId": "https://requests.example.com/a2ui/catalog.json",
                    "args": {
                      "text": {
                        "@path": "/comment"
                      }
                    }
                  }
                }
              }
            },
            "@checks": [
              {
                "condition": {
                  "@call": "commentFits",
                  "catalogId": "https://requests.example.com/a2ui/catalog.json",
                  "args": {
                    "text": {
                      "@path": "/comment"
                    }
                  }
                },
                "message": "コメントは2,000文字以内で書いてください。"
              }
            ]
          },
          {
            "id": "button.discard.shown",
            "component": "Show",
            "@catalogId": "https://requests.example.com/a2ui/catalog.json",
            "when": {
              "@path": "/can/discard"
            },
            "child": "button.discard"
          },
          {
            "id": "buttons",
            "component": "Row",
            "children": [
              "button.submit.shown",
              "button.resubmit.shown",
              "button.discard.shown"
            ]
          },
          {
            "id": "root",
            "component": "Column",
            "children": [
              "title",
              "requester.shown",
              "sent_back.shown",
              "refused.shown",
              "field.kind",
              "field.kind.refused.shown",
              "field.first_day",
              "field.first_day.refused.shown",
              "field.days",
              "field.days.refused.shown",
              "field.reason",
              "field.reason.refused.shown",
              "field.cover",
              "field.cover.refused.shown",
              "comment",
              "comment.refused.shown",
              "buttons"
            ]
          }
        ]
      }
    }
  ]
}
