{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Code generated by ritsu <version>. DO NOT EDIT.",
  "title": "A version of the organization `company` (Company)",
  "type": "object",
  "required": [
    "teams",
    "people",
    "members"
  ],
  "properties": {
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "parent",
          "head"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "name_ja": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "company",
              "division",
              "department",
              "section",
              "committee"
            ]
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "description": "The team above it; null or empty for the team at the top"
          },
          "head": {
            "type": [
              "string",
              "null"
            ],
            "description": "The ID of its head; null or empty while there is none"
          }
        }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "name_ja": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "en",
              "ja",
              "",
              null
            ],
            "description": "The language the person reads their notices and pages in, `en` or `ja`; empty or null for the language of each kind"
          }
        }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "person",
          "team",
          "position",
          "primary"
        ],
        "properties": {
          "person": {
            "type": "string",
            "minLength": 1
          },
          "team": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "enum": [
              "staff",
              "manager",
              "dept_head",
              "division_head",
              "president"
            ]
          },
          "primary": {
            "enum": [
              true,
              false,
              "yes",
              "no",
              "",
              null
            ],
            "description": "Whether it is the person's primary team: true or `yes`; false, `no`, empty or null for a team they also belong to"
          }
        }
      }
    }
  },
  "$defs": {
    "proxy": {
      "type": "object",
      "required": [
        "person",
        "proxy",
        "kind",
        "from",
        "to"
      ],
      "properties": {
        "person": {
          "type": "string"
        },
        "proxy": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "approve",
            "submit"
          ]
        },
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "description": "The last day, which it includes; empty or null for no end"
        },
        "requests": {
          "type": [
            "string",
            "null"
          ],
          "description": "The kinds of request it is for, their ASCII names apart with spaces; empty or null for every kind"
        }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "day",
        "version",
        "positions",
        "teams",
        "people",
        "members",
        "proxies",
        "rows"
      ],
      "properties": {
        "day": {
          "type": "string",
          "format": "date"
        },
        "version": {
          "type": "string",
          "format": "date"
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The positions in ASCII, the lowest first"
        },
        "teams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "parent",
              "head"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "parent": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "head": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "people": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "name_ja"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "name_ja": {
                "type": "string"
              }
            }
          },
          "description": "The people the ticket needs, each with their names as the data writes them (an empty string where it has none), which a refusal says after the ID"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "person",
              "team",
              "position",
              "primary"
            ],
            "properties": {
              "person": {
                "type": "string"
              },
              "team": {
                "type": "string"
              },
              "position": {
                "type": "string"
              },
              "primary": {
                "type": "boolean"
              }
            }
          }
        },
        "proxies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "person",
              "proxy",
              "kind"
            ],
            "properties": {
              "person": {
                "type": "string"
              },
              "proxy": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "approve",
                  "submit"
                ]
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "master",
              "key",
              "values"
            ],
            "properties": {
              "master": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "value"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "description": "The part of the organization `start` and `next` are given: of the version in effect on the day of the event, what the ticket needs, as the vectors' `organization` holds it"
    }
  }
}
