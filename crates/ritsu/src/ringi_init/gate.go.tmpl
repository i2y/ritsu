package {{package}}

import (
	"context"
	"errors"
	"log/slog"
	"slices"
	"sync"

	server "{{framework}}"

	"{{module}}/go/authz/company"
)

// Gate answers whether a person may do what they ask to do. It asks the code ritsu made from
// project/shared/company.gate (go/authz/company), and gives it what that code reads of the framework's
// question: the person's department and roles, whether they are a requester or an approver of the
// request, and the team that owns its type.
//
// A role added to company.gate needs no change here, as the code that was made lists the roles
// (RolesOf). An attribute added to a principal or a resource does: gateStore gives its value.
type Gate struct {
	// Log is where Gate says that a sign-in gave a role the gate does not declare: once for each
	// role, for the first hundred of them.
	Log *slog.Logger

	mu   sync.Mutex
	told map[string]bool
}

// gateRoles are the roles a Staff of project/shared/company.gate can have, in the order the gate
// declares them. The code that was made refuses a person with a role it does not declare, whatever
// they ask, so Allow leaves out the roles a sign-in gives for something else (a claim of the provider,
// a header of the proxy).
func gateRoles() []string {
	return company.RolesOf("Staff")
}

// Allow asks the gate by the action's name, with the ID of each resource the framework knows: the
// ticket, its stage, its kind of request (the version the question is of), and the organization.
// The gate takes the one its action is about. An action the gate does not declare is an error. Its
// other refusals are a no, also for a person it cannot read: one with no primary team in the
// organization's data.
func (g *Gate) Allow(_ context.Context, q server.Question) (bool, error) {
	ids := map[string]string{"Ticket": q.Ticket, "Stage": q.Ticket + "/" + q.Stage, "RequestType": q.Kind, "Organization": "organization"}
	store := gateStore{q: q, roles: g.roles(q.Person)}
	a := company.Authorize(store, company.Principal{Type: "Staff", ID: q.Person.ID}, q.Action, ids, q.Now)
	if a.Err != nil && a.Err.Kind == "action" {
		return false, errors.New(a.Err.Message)
	}
	return a.Err == nil && a.Allowed, nil
}

// roles answers the roles of the person the gate declares, in the order the sign-in gives them:
// staff when it gives none of them. A role left out is said in the log.
func (g *Gate) roles(p server.Person) []string {
	declared := gateRoles()
	var kept []string
	for _, r := range p.Roles {
		switch {
		case !slices.Contains(declared, r):
			g.leftOut(r, p.ID)
		case !slices.Contains(kept, r):
			kept = append(kept, r)
		}
	}
	if len(kept) == 0 {
		return []string{"staff"}
	}
	return kept
}

// leftOut says in the log that the gate does not declare role, the first time a sign-in gives it.
// It keeps the names of a hundred roles at the most, as the names come from outside.
func (g *Gate) leftOut(role, person string) {
	g.mu.Lock()
	defer g.mu.Unlock()
	if g.told[role] || len(g.told) >= 100 {
		return
	}
	if g.told == nil {
		g.told = map[string]bool{}
	}
	g.told[role] = true
	if g.Log != nil {
		g.Log.Warn("the gate does not declare a role the sign-in gives, and is asked without it", "role", role, "person", person)
	}
}

// gateStore is what the gate reads, from one question.
type gateStore struct {
	q     server.Question
	roles []string
}

// Staff answers the person as the gate reads them: their department, their roles, and whether they
// are a requester or an approver of the request.
//
// Their department is the team of theirs that is of the same kind as the team that owns the request
// type: the first of that kind at or above their primary team. So a type a section owns is compared
// section by section, and one a department owns department by department, whatever the organization
// calls its kinds of team. When no team of the organization's data owns the type (the question is of
// the organization, or the type names no owner or a team that is not there), it is their primary
// team, which owns nothing.
//
// The answer is nil for a person with no primary team in the organization's data. The gate refuses
// them whatever they ask, so that no one outside the organization is taken as one of a department.
func (s gateStore) Staff(id string) (*company.Staff, error) {
	kind := ""
	if owner, ok := teamIn(s.q.Org, s.q.Owner); ok {
		kind = owner.Kind
	}
	department := s.q.Org.TeamOf(id, kind)
	if department == "" {
		return nil, nil
	}
	st := &company.Staff{Department: department}
	if id == s.q.Person.ID {
		st.Roles = s.roles
		if slices.Contains(s.q.Requesters, id) {
			st.MemberOfRequesters = []string{"requesters"}
		}
		if slices.Contains(s.q.Approvers, id) {
			st.MemberOfApprovers = []string{"approvers"}
		}
	}
	return st, nil
}

func (s gateStore) Stage(string) (*company.Stage, error) {
	return &company.Stage{Requester: s.q.Requester, Requesters: "requesters", Approvers: "approvers", Owner: s.owner(), SelfApproval: s.q.SelfApproval}, nil
}

func (s gateStore) Ticket(string) (*company.Ticket, error) {
	return &company.Ticket{Requester: s.q.Requester, Requesters: "requesters", Owner: s.owner()}, nil
}

func (s gateStore) RequestType(string) (*company.RequestType, error) {
	return &company.RequestType{Owner: s.owner()}, nil
}

// owner answers the team that owns the request type. For a type that names no owner, it answers an ID
// that no team of the organization's data has. It is then no one's department, and only a rule that
// reads no department (a system administrator's) allows anything of the type.
func (s gateStore) owner() string {
	if s.q.Owner != "" {
		return s.q.Owner
	}
	id := "(no owner)"
	for {
		if _, ok := teamIn(s.q.Org, id); !ok {
			return id
		}
		id = "(" + id + ")"
	}
}

// teamIn answers the team with the ID id in v, the organization's data of a day, and whether it has
// one.
func teamIn(v *server.OrgVersion, id string) (server.Team, bool) {
	if v != nil {
		for _, t := range v.Teams {
			if t.ID == id {
				return t, true
			}
		}
	}
	return server.Team{}, false
}
