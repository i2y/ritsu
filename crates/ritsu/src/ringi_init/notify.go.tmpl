package {{package}}

import (
	"context"
	"log/slog"
	"strings"

	server "{{framework}}"
)

// LogNotifier writes each notice to the log: what happened, to which request, and the people to tell
// with their addresses from the organization's data. Write a part that sends a mail or a chat message
// in its place. It should write to each person in their own language, and send a notice once: the
// framework calls it again with the same key (Notice.Key) when it cannot tell whether a notice was
// sent.
type LogNotifier struct {
	// Server is the server that sends the notices. Started sets it, once the server is made.
	Server *server.Server
	Log    *slog.Logger
	// Lang is the language the title of the request type is written in; "en" when empty. The log
	// also says which language the title is in: a type with no title in Lang has the one its file
	// gives it.
	Lang string
}

// Notify writes the notice.
func (n *LogNotifier) Notify(_ context.Context, x server.Notice) error {
	to := make([]string, 0, len(x.To))
	for _, r := range x.To {
		to = append(to, r.ID+" "+r.Email)
	}
	lang := n.Lang
	if lang == "" {
		lang = "en"
	}
	title, in := n.Server.Title(x.Kind, x.Version, lang)
	n.Log.Info("notice", "notice", x.Notice, "to", strings.Join(to, ", "), "kind", x.Kind, "title", title, "title_lang", in, "ticket", x.Ticket, "stage", x.Stage)
	return nil
}
