workflow expense_payment v1
description "The payment of an approved expense claim: the requester is paid back, and told. The claim starts it when it is approved; the tasks are the project's own (payments.go)"

inputs
  request_id : string
  requester  : string
  amount     : money[JPY]  range >=1JPY <=1_000_000JPY
  purpose    : string

outputs
  reference : string

record Payment
  reference : string

task pay_requester(request_id: string, requester: string, amount: money[JPY], purpose: string) -> Payment
  timeout 1 day
  retry 3 times every 10 minutes
  idempotent

task tell_requester(request_id: string, text: string)
  idempotent

flow
  let p = pay_requester(request_id: request_id, requester: requester, amount: amount, purpose: purpose)
  tell_requester(request_id: request_id, text: "Request {request_id} was paid: {p.reference}")
  succeed reference = p.reference
