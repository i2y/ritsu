  entity(y:artifact/ea0260ec1a10f1e7f6840ff2f1e24157, [prov:type='yurai:Artifact', prov:label="file \"民法の期間.cal\"", yurai:sha256="c9b94eecde23e6b5", yurai:end="file"])
  entity(y:requirement/first_day/v1, [prov:type='yurai:Requirement', prov:label="起算日", yurai:version="1", yurai:text="日、週、月又は年によって期間を定めたときは、期間の初日は、算入しない。ただし、その期間が午前零時から始まるときは、この限りでない", yurai:inForce="2026-10-01..", yurai:sha256="a9ebc73907faddc8"])
  entity(y:requirement/last_day/v1, [prov:type='yurai:Requirement', prov:label="満了日", yurai:version="1", yurai:text="月によって期間を定めたときは、最後の月においてその起算日に応当する日の前日の終わりに満了する。応当する日がないときは、その月の末日の終わりに満了する", yurai:inForce="2026-10-01..", yurai:sha256="465b83ed8c251406"])
  entity(y:requirement/last_day_142/v1, [prov:type='yurai:Requirement', prov:label="満了日_142条", yurai:version="1", yurai:text="期間の末日が日曜日、国民の祝日に関する法律に規定する休日その他の休日に当たるときは、その日に取引をしない慣習がある場合に限り、期間は、その翌日に満了する", yurai:inForce="2026-10-01..", yurai:sha256="d4f2d2a67322df17"])
  wasAttributedTo(y:requirement/first_day/v1, y:role/法務, [prov:type='yurai:owner'])
