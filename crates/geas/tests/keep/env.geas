# A value from geas's own environment goes out and is told to nobody, though the service sends it
# back in its body and in a header.
target api {
  serve "python3 mirror.py {port}"
  port auto
}

mask header "date"
mask header "server"

claim "the key goes in a header" {
  keep env "GEAS_TEST_KEY" as key
  when api.get("/saved/a", header "authorization": "Bearer {key}", header "x-echo": "{key}")
  then status is 200
  and  body json ".headers[0][1]" is "Bearer {key}"
  and  header "x-echoed" is "{key}"
  and  body contains "{key}"
}

claim "a check that fails tells it to nobody" {
  keep env "GEAS_TEST_KEY" as key
  when api.post("/saved/b", body: "{key}", header "authorization": "Bearer {key}")
  then body json ".body" is "not {key}"
  and  body json ".headers[0][1]" contains "nothing"
  and  body is "nothing"
  keep body json ".body" as sent
  and  body json ".body" is "{sent} {sent}"
  when api.get("/saved/c", header "x-echo": "{key}")
  then header "x-echoed" is "not it"
}

claim "keep env can come later, and the path can hold it" {
  when api.get("/a")
  keep env "GEAS_TEST_KEY" as key
  when api.get("/saved/{key}/b")
  then body json ".path" contains "{key}"
}
