# echo stands in for the address lookup
# the key the tests look addresses up with: AIzaSyD-ritsu-fake-key-for-tests-000000   # ritsu: test secret
# the key of the real service, which is not one for tests: AIzaSyD-ritsu-fake-key-for-tests-000000

target lookup {
  run "echo"
}

claim "passes the address on" {
  when lookup.run("1600 Amphitheatre Parkway")
  then stdout is "1600 Amphitheatre Parkway"
}
