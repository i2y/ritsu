# boto3, which the Python the generated code sends AWS calls with, and moto, which plays the AWS
# APIs on this machine for tools/wire/check.mjs and check.py. requirements.txt is the lock, made
# from this with
#   uv pip compile requirements.in --python-version 3.13 --generate-hashes -o requirements.txt
# and installed with
#   uv venv --python 3.13 tools/wire/.venv
#   uv pip install --python tools/wire/.venv/bin/python -r tools/wire/requirements.txt
boto3==1.43.103
moto[server]==5.2.3
