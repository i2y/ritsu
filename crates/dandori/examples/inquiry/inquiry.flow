workflow 問い合わせ v1
description "お客さまの問い合わせを、エージェントが読んで種類と注文番号と要点を取り出し、受け持つ窓口と返事の期限は規則が決め、返事の下書きをエージェントが書いて、窓口のシステムに起票する。読むことと書くことはエージェント、決めることは規則が受け持つ"

use rule 振り分け from "rules/問い合わせの振り分け.rule"
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:inquiry-routing"

record 問い合わせ
  id   : string
  会員 : bool
  本文 : string

record 読み取り
  種類   : 振り分け.種類
  注文ID : string?
  要点   : string

record 起票
  チケットID : string

inputs
  問い合わせ : 問い合わせ

outputs
  チケットID : string
  窓口       : 振り分け.窓口

# The model reads the text; the schema of 読み取り holds its answer to one of the rule's kinds.
task 読み取る(本文: string) -> 読み取り
  agent "お客さまからの問い合わせの本文を読み、種類を一つ選び、注文番号が書かれていれば取り出し、要点を一文にまとめてください。注文番号が書かれていなければ null にします。"
  model "gpt-5.4-mini"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/openai/5e6f7a8b"
  timeout 60 seconds
  retry 2 times every 10 seconds

task 下書きする(種類: 振り分け.種類, 要点: string, 注文ID: string?, 期限: duration[h]) -> string
  agent "問い合わせへの最初の返事を、丁寧な日本語で三文以内に下書きしてください。期限は返事をするまでの時間の数です。約束できないことは書きません。"
  model "gpt-5.4-mini"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/openai/5e6f7a8b"
  timeout 60 seconds

task 起票する(問い合わせID: string, 窓口: 振り分け.窓口, 期限: duration[h], 件名: string, 本文: string, 下書き: string?) -> 起票
  http POST "https://helpdesk.example.com/v1/tickets"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/helpdesk/7a8b9c0d"
  key
  retry 2 times every 5 seconds

flow
  let 読 = 読み取る(本文: 問い合わせ.本文)
    on failure =>
      let 手で = 起票する(問い合わせID: 問い合わせ.id, 窓口: 総合, 期限: 24, 件名: "読み取れなかった問い合わせ", 本文: 問い合わせ.本文, 下書き: none)
      succeed チケットID = 手で.チケットID, 窓口 = 総合
  let 判定 = 振り分け(種類: 読.種類, 会員: 問い合わせ.会員)
  let 件名 = "{読.種類}の問い合わせ"
  match 読.注文ID
    some 注文ID => let 件名 = "{読.種類}の問い合わせ（注文 {注文ID}）"
    none => pass
  let 下書き = 下書きする(種類: 読.種類, 要点: 読.要点, 注文ID: 読.注文ID, 期限: 判定.期限)
    on failure => let 下書き: string? = none
  let t = 起票する(問い合わせID: 問い合わせ.id, 窓口: 判定.窓口, 期限: 判定.期限, 件名: 件名, 本文: 問い合わせ.本文, 下書き: 下書き)
  succeed チケットID = t.チケットID, 窓口 = 判定.窓口
