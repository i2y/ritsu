workflow review v1
description "Send an application to be scored on workers of their own, and when the score says hold, wait for a person's approval. Every task is one the user writes, so it goes to the platforms that run the user's code: Temporal, Lambda durable functions, Argo Workflows (images) and pydantic-graph, not Step Functions"

enum Verdict = approve | reject | hold

record Application
  id     : string
  amount : int

record Score
  points  : int
  verdict : Verdict

record Approval
  approver : string

inputs
  application : Application

outputs
  verdict : Verdict

# Scoring runs on workers of its own, which may be written in another language.
task score(application_id: string, amount: int) -> Score
  queue "scoring"
  image "registry.example.com/review/scoring:1"
  errors unscorable
  retry 2 times every 10 seconds
  idempotent

# Someone approves in a tool of their own, and the answer comes back with the callback's id.
task ask_for_approval(application_id: string, points: int) -> Approval
  image "registry.example.com/review/approval:1"
  callback
  timeout 3 days

task notify(application_id: string, text: string)
  queue "notify"
  image "registry.example.com/review/notify:1"
  idempotent

flow
  let r = score(application_id: application.id, amount: application.amount)
    on unscorable => fail Unscorable "Could not score application {application.id}"
  match r.verdict
    approve, reject => pass
    hold =>
      let a = ask_for_approval(application_id: application.id, points: r.points)
        on timeout => fail NoAnswer "No approval in three days"
      notify(application_id: application.id, text: "{a.approver} approved application {application.id}")
      succeed verdict = approve
  notify(application_id: application.id, text: "Application {application.id} was reviewed: {r.verdict}")
  succeed verdict = r.verdict
