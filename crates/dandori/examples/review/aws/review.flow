workflow review v1
description "Jev scores an application and says how sure it is, and a rule decides whether the verdict is acted on at once or goes to a person for approval, due by 17:00 on the third business day after it comes in: approving at once asks more certainty than rejecting at once. Written for AWS, where Lambda durable functions runs it: the scoring is a step that calls Jev over HTTP, the rule and the date of the approval Lambda functions a step invokes, and the other tasks are code you write, which a step runs; the approver's tool answers the callback by its id (SendDurableExecutionCallbackSuccess). Step Functions cannot run it, since asking for the approval and the notice are not calls Step Functions makes"

use rule policy from "../rules/review_policy.rule"
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:review-policy"
use dates approvals from "../dates/approval_terms.cal"
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:approval-terms"

record Application
  id      : string
  amount  : int
  purpose : string

record Score
  verdict : policy.verdict
  sure    : rate[step 1%]  range >=0 <=100

record Approval
  approver : string

inputs
  application : Application

outputs
  verdict : policy.verdict

# Jev places what the applicant wrote on the scale of verdicts, from the lowest level, and how
# sure it is of the verdict comes as a rate, for the rule to weigh.
task score(purpose: string) -> Score
  jev
    verdict score "How clearly is the money for running the business?"
      reject "It is for something personal or speculative, or against the law"
      hold "It is for the business, but the statement leaves unclear what it pays for"
      approve "It pays for a named part of running the business, such as stock, equipment, staff or premises"
    sure confidence of verdict
  model "jev-1.13.0"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/typesafe/8b9c0d1e"
  errors busy = 429, overloaded = 529
  retry 2 times every 10 seconds on busy, overloaded
  timeout 10 seconds

# Someone approves in a tool of their own, and the answer comes back with the callback's id. The
# approver is told when the approval is due, and the wait ends then.
task ask_for_approval(application_id: string, amount: int, sure: rate[step 1%], by: timestamp) -> Approval
  callback
  timeout until by

task notify(application_id: string, text: string)
  idempotent

flow
  let r = score(purpose: application.purpose)
    on failure => fail Unscorable "Could not score application {application.id}"
  let d = policy(verdict: r.verdict, sure: r.sure)
  match d.decision
    approve, reject => pass
    ask =>
      let due = approvals.due(received: now)
      let a = ask_for_approval(application_id: application.id, amount: application.amount, sure: r.sure, by: due.at)
        on timeout => fail NoAnswer "No approval by 17:00 on the third business day"
      notify(application_id: application.id, text: "{a.approver} approved application {application.id}")
      succeed verdict = approve
  notify(application_id: application.id, text: "Application {application.id} was reviewed: {r.verdict}")
  succeed verdict = r.verdict
