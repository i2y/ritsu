# A request for a refund, paid out of what is left of the order. Hand-written code takes the amount
# from the request the API took, and what is left from the book, and starts the run with them. Each
# `fed by` says where one of those values comes from: `ritsu check` holds the range of its values,
# and the code that carries them is not checked. It runs on every platform.
workflow refund_request v1
description "Pays a refund out of what is left of the order"

record Balance
  left : money[USDc]  range >=0USDc <=10000000USDc  fed by chobo "books/refunds.book" account remaining

inputs
  amount  : money[USDc]  range >=1USDc <=1000000USDc  fed by openapi "specs/refunds.json" schema RefundCreate property amount
  reason  : string  fed by openapi "specs/refunds.json" schema RefundCreate property reason
  balance : Balance

outputs
  paid : bool

task pay_out(amount: money[USDc], left: money[USDc], reason: string) -> bool
  lambda "arn:aws:lambda:us-east-1:123456789012:function:pay-out"
  idempotent

flow
  let done = pay_out(amount: amount, left: balance.left, reason: reason)
  succeed paid = done
