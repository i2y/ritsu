# モジュールの外へ出るパス。lib の帳簿はディスクにはあるが、app はそれを運ばないので、app を使う側では
# たどれない。依存のファイルは `@lib/…` で指す。
workflow 注文を受ける v1
description "注文の値段をモジュール lib の流れで決め、その合計を lib の台帳で請求する"

use rule 合計 from "@lib/規則/注文の合計.rule"
use book 台帳 from "../../部品/帳簿/台帳.book"
use proto 注文 from "@lib/proto/acme/orders/v1/order.proto"

record 値段
  合計額 : money[GBPc]

inputs
  受注 : 注文.Order
  小計 : money[GBPc]  range >=0GBPc <=2_000_000GBPc
  区分 : 合計.区分
  送料 : money[GBPc]  range >=0GBPc <=10_000GBPc

outputs
  金額 : money[GBPc]

task 値を付ける(小計: money[GBPc] range >=0GBPc <=2_000_000GBPc, 区分: 合計.区分, 送料: money[GBPc] range >=0GBPc <=10_000GBPc) -> 値段
  flow "@lib/流れ/値付け.flow"

task 請求を記す(注文: string, 金額: money[GBPc])
  book 台帳.請求.do

flow
  let 付けた値 = 値を付ける(小計: 小計, 区分: 区分, 送料: 送料)
  請求を記す(注文: 受注.id, 金額: 付けた値.合計額)
  succeed 金額 = 付けた値.合計額
