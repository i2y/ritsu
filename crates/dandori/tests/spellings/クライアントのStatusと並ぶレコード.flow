workflow クライアントのStatusと並ぶレコード v1 implements svc.Svc
description "レコード `Status` とメソッド `GetStatus` です。応答の型は Go では `Where` です。"

use proto svc from "protos/クライアントのStatusと並ぶレコード.proto"

record Sent
  note : string

record Status
  state : string

inputs
  id : string

outputs
  id : string

task 見る(id: string) -> Status

task 待つ() -> Sent
  event
  timeout 1 day

flow
  let now = 見る(id: id)
  let s = 待つ()
    on timeout => fail Late "知らせがありません"
  succeed id = "{id} {now.state} {s.note}"
