workflow ts_word v1
description "A record and an enum named as words of TypeScript."

record Day
  day : string

enum Slot = early | late

inputs
  id : string

outputs
  day : string
  slot : Slot

task when(id: string) -> Day
task slot(id: string) -> Slot

flow
  let d = when(id: id)
  let s = slot(id: id)
  succeed day = d.day, slot = s
