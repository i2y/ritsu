workflow go_book_names v1
description "Types named as what the package of Go declares for a flow that runs a book's operations."

use book stock from "../books/stock.book"

record Call
  note : string

record Answer
  count : int

enum Carrier = air | rail

record Everything
  call : Call
  result : Answer
  transport : Carrier

inputs
  id : string

outputs
  everything : Everything

task receive(delivery: string, sku: string, qty: int)
  book stock.receive.do

task gather() -> Everything

flow
  receive(delivery: id, sku: "a", qty: 1)
  let everything = gather()
  succeed everything = everything
