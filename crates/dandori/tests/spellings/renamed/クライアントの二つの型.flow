workflow クライアントの二つの型 v1 implements svc.Svc
description "入力と出力の二つの型に使う一つのメッセージです。"

use proto svc from "protos/クライアントの二つの型.proto"

record Sent
  note : string

inputs
  id : string

outputs
  id : string

task 待つ() -> Sent
  event
  timeout 1 day

flow
  let s = 待つ()
    on timeout => fail Late "知らせがありません"
  succeed id = "{id} {s.note}"
