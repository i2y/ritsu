workflow クライアントの同じ関数 v1 implements svc.Svc
description "クライアントの関数と同じことをするメソッドです。`Start` はワークフローを始め、`Status` は実行がどこにいるかを言うので、クライアントはほかの関数を書きません。"

use proto svc from "protos/クライアントの同じ関数.proto"

record Sent
  note : string

inputs
  id : string

outputs
  id : string

task 待つ() -> Sent
  event
  timeout 1 day

flow
  let s = 待つ()
    on timeout => fail Late "知らせがありません"
  succeed id = "{id} {s.note}"
