workflow client_status v1 implements svc.Svc
description "The method that tells where a run is, named `Status`, with the message `Status`: in Go a function, which reads the type `Where`."

use proto svc from "protos/client_status.proto"

record Sent
  note : string

inputs
  id : string

outputs
  id : string

task wait() -> Sent
  event
  timeout 1 day

flow
  let s = wait()
    on timeout => fail Late "no word"
  succeed id = "{id} {s.note}"
