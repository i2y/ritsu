workflow クライアントのhistoriesで状態 v1 implements svc.Svc
description "実行がどこにいるかを言うメソッドで、クライアントの実行の履歴を並べる関数と同じ名前です。"

use proto svc from "protos/クライアントのhistoriesで状態.proto"

record Sent
  note : string

inputs
  id : string

outputs
  id : string

task 待つ() -> Sent
  event
  timeout 1 day

flow
  let s = 待つ()
    on timeout => fail Late "知らせがありません"
  succeed id = "{id} {s.note}"
