workflow client_same v1 implements svc.Svc
description "The methods named as the functions of the client that do the same: `Start` starts the workflow and `Status` tells where a run is, so the client writes no other function."

use proto svc from "protos/client_same.proto"

record Sent
  note : string

inputs
  id : string

outputs
  id : string

task wait() -> Sent
  event
  timeout 1 day

flow
  let s = wait()
    on timeout => fail Late "no word"
  succeed id = "{id} {s.note}"
