workflow client_histories_status v1 implements svc.Svc
description "The method that tells where a run is, named as the function of the client that lists the histories of the runs."

use proto svc from "protos/client_histories_status.proto"

record Sent
  note : string

inputs
  id : string

outputs
  id : string

task wait() -> Sent
  event
  timeout 1 day

flow
  let s = wait()
    on timeout => fail Late "no word"
  succeed id = "{id} {s.note}"
