workflow client_module v1 implements svc.Svc
description "Methods named as what the module of the client of TypeScript has: require, exports and globalThis."

use proto svc from "protos/client_module.proto"

record Sent
  note : string

inputs
  id : string

outputs
  id : string

task wait() -> Sent
  event
  timeout 1 day

flow
  let s = wait()
    on timeout => fail Late "no word"
  succeed id = "{id} {s.note}"
