workflow protoの型の名前 v1
description "TypeScript、Python、Go のコードで、.proto のメッセージと同じ名前になるレコードです。"

use proto 店 from "protos/protoの型の名前.proto"

record 店_Item
  注記 : string

inputs
  番号 : string

outputs
  品番 : string
  注記 : string

task 品を探す(番号: string) -> 店.Item
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:find-item"

task 注記を探す(番号: string) -> 店_Item
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:find-note"

flow
  let a = 品を探す(番号: 番号)
  let b = 注記を探す(番号: 番号)
  succeed 品番 = a.品番, 注記 = b.注記
