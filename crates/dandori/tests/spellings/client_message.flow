workflow client_message v1 implements svc.Svc
description "A message named as a type the client has."

use proto svc from "protos/client_message.proto"

record Sent
  note : string

inputs
  id : string

outputs
  id : string

task wait() -> Sent
  event
  timeout 1 day

flow
  let s = wait()
    on timeout => fail Late "no word"
  succeed id = "{id} {s.note}"
