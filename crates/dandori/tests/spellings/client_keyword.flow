workflow client_keyword v1 implements svc.Svc
description "A method and a message named as words of TypeScript, which the client of TypeScript cannot declare."

use proto svc from "protos/client_keyword.proto"

record Sent
  note : string

inputs
  id : string

outputs
  id : string

task wait() -> Sent
  event
  timeout 1 day

flow
  let s = wait()
    on timeout => fail Late "no word"
  succeed id = "{id} {s.note}"
