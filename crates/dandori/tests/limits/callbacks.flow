workflow callbacks v1
description "A callback whose task does not hand its id on within the minute that every platform gives it: the try times out, is tried again a second later, times out again, and then its `on timeout` runs. The tests of the limits play it with the platforms' own times; Step Functions ends each try at the task's `timeout`, which bounds the hand-on and the wait together"

record Packing
  boxes : int

inputs
  order : string

outputs
  said : string

# The warehouse gets the callback's id and answers when the order is packed.
task pack(order: string) -> Packing
  lambda "arn:aws:lambda:us-east-1:123456789012:function:pack"
  callback
  timeout 30 seconds
  retry 1 times every 1 second
  idempotent

flow
  let p = pack(order: order)
    on timeout => succeed said = "the warehouse did not take the order in time"
  succeed said = "packed in {p.boxes} boxes"
