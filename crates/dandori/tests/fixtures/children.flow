workflow children v1
description "子ワークフローの契約：ほかの .flow を走らせるタスクの引数・結果・エラーと、子の入力・出力・失敗"

enum 区分 = 個人 | 法人
enum 団体もある区分 = 個人 | 法人 | 団体
enum 結論 = 可 | 保留

record 申込
  id   : string
  額   : int  range >=1 <=1000000
  区分 : 区分

record 範囲の無い申込
  id   : string
  額   : int
  区分 : 区分

record 団体もある申込
  id   : string
  額   : int  range >=1 <=1000000
  区分 : 団体もある区分

record 結果
  結論 : 結論
  点   : int  range >=0 <=100

record 狭い結果
  結論 : 結論
  点   : int  range >=0 <=50
  理由 : string

inputs
  申込 : 申込

# 子の入力・出力・失敗に合う
task 合う(申込: 申込, 担当: string?) -> 結果
  flow "children/査定.flow"
  errors 要確認

task 名前の違う(申込: 申込, 係: string) -> 結果
  flow "children/査定.flow"

task 渡さない(担当: string?) -> 結果
  flow "children/査定.flow"

task 値の多い(申込: 団体もある申込) -> 結果
  flow "children/査定.flow"

task 範囲の無い(申込: 範囲の無い申込) -> 結果
  flow "children/査定.flow"

task 答えの合わない(申込: 申込) -> 狭い結果
  flow "children/査定.flow"

task 数を読む(申込: 申込) -> int
  flow "children/査定.flow"

task 無いエラー(申込: 申込) -> 結果
  flow "children/査定.flow"
  errors 却下

task 呼び方の重なる(申込: 申込) -> 結果
  flow "children/査定.flow"
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:review"

task 無いフロー(申込: 申込) -> 結果
  flow "children/無い.flow"

task 通らないフロー(n: int)
  flow "children/自分.flow"

flow
  let r = 合う(申込: 申込, 担当: none)
  pass
