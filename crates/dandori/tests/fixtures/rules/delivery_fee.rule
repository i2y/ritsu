rule 配送料金(delivery_fee) v1

import proto "order.proto" MemberTier -> 会員区分
enum 会員区分(tier) = 一般(basic) | ゴールド(gold) default

inputs
  会員(m) : 会員区分

outputs
  送料(fee) : money[円, incl_tax]  round up(10円)

table 送料表(fee_table)
policy first
| 会員 | -> 送料(fee) : money[円, incl_tax] |
| 一般 | 800円 |
| - | 400円 |
