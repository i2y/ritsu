workflow 判断の列挙の範囲 v1
description "判断のモデルの答えにある列挙の範囲：Jev には範囲に入る値の中から尋ねるので、意味はその値に書き、choice の選択肢は二つ以上要る"

use rule 送料 from "rules/会員段階の送料.rule"

inputs
  メモ : string

# 一般・シルバー・ゴールドの中から尋ねる
task 勧める(メモ: string) -> 送料.段階  range >=一般 <=ゴールド
  jev "この会員に合うキャンペーンはどれか"
    一般 "入会したばかりの会員"
    ゴールド "毎週注文する会員"
  model "jev-1.13.0"

# 範囲の外の段階は尋ねない
task 測る(メモ: string) -> 送料.段階  range >=シルバー <=ゴールド
  jev score "この会員はどれほど常連か"
    シルバー "ときどき注文する"
    ゴールド "毎週注文する"
    プラチナ "毎日注文する"
  model "jev-1.13.0"

# 値が一つでは選べない
task 一つだけ(メモ: string) -> 送料.段階  range >=ゴールド <=ゴールド
  jev "この会員に合うキャンペーンはどれか"
  model "jev-1.13.0"

flow
  let a = 勧める(メモ: メモ)
  let b = 測る(メモ: メモ)
  let c = 一つだけ(メモ: メモ)
