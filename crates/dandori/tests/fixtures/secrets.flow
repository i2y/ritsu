workflow secrets v1
description "Where a value is marked secret, and what holds one: the marks of a .proto, of an OpenAPI document and of the .flow, through records, lists, strings, for, some and json; a rule's answer and an unmarked answer hold none"

use proto bank from "secrets/bank/v1/bank.proto"
  url "https://bank.example.com"
use openapi crm from "secrets/crm.json"
use rule routing from "../../examples/inquiry/rules/inquiry_routing.rule"
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:inquiry-routing"

record Contact
  name  : string
  phone : string  secret

record Note
  to   : string
  text : string

record Customer
  id      : string
  email   : string
  segment : string
  pin     : string?

record Session
  token : string

inputs
  customer_id  : string
  api_token    : string  secret
  backup_token : string?  secret
  contacts     : list[Contact]
  kind         : routing.kind
  member       : bool  secret

outputs
  payment : string
  contact : string

task get_account(id: string) -> bank.Account
  connect bank "AccountService/GetAccount"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/bank/1"

task get_customer(id: string) -> Customer
  http GET crm "/customers/{id}"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/crm/1"

task sign_in(user: string, password: string) -> Session
  http POST crm "/sessions"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/crm/1"
  idempotent

task pay(account_id: string, amount: int, note: string) -> bank.PayResponse
  connect bank "PayoutService/Pay"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/bank/1"
  key

task pay_to(account_number: string, amount: int) -> bank.PayResponse
  connect bank "PayoutService/Pay"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/bank/1"
  key

task file_note(note: Note)
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:file-note"
  idempotent

task keep(value: json)
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:keep"
  idempotent

task summarize(text: string) -> string
  agent "Say what the text is about, in one sentence."
  model "gpt-5.4-mini"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/openai/1"
  discloses text "The provider keeps no data under the agreement with it"

flow
  let account = get_account(id: customer_id)
  let customer = get_customer(id: customer_id)
  let session = sign_in(user: customer_id, password: api_token)
  let route = routing(kind: kind, member: member)
  let note: Note = {to: customer.email, text: "Paid to {account.holder}"}
  file_note(note: note)
  for c in contacts at most 10
    keep(value: c)
  let tokens = [session.token, customer_id]
  keep(value: tokens)
  let bundle: json = {token: api_token, desk: route.desk}
  keep(value: bundle)
  keep(value: route.within)
  match backup_token
    none => fail NoBackup "no backup token for {customer.email}"
    some t => keep(value: t)
  let summary = summarize(text: customer.email)
  let paid = pay(account_id: account.id, amount: 100, note: summary)
  pay_to(account_number: account.branch, amount: 100)
  succeed payment = paid.paymentId, contact = customer.email
