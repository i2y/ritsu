workflow 秘密の値 v1
description "値に秘密の印が付くところと、秘密の値を持つもの：.proto、OpenAPI の文書、.flow の三つの印を、レコード、リスト、文字列、for、some、json を通してたどる。規則の結果と、印の無いタスクの結果は秘密にしない"

use proto 銀行 from "secrets/bank/v1/bank.proto"
  url "https://bank.example.com"
use openapi 顧客 from "secrets/crm.json"
use rule 振り分け from "../../examples/inquiry/rules/問い合わせの振り分け.rule"
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:inquiry-routing"

record 連絡先
  名前 : string
  電話 : string  secret

record メモ
  宛先 : string
  本文 : string

record 顧客情報
  id      : string
  email   : string
  segment : string
  pin     : string?

record セッション
  token : string

inputs
  顧客番号       : string
  APIトークン    : string  secret
  予備のトークン : string?  secret
  連絡先の一覧   : list[連絡先]
  種類           : 振り分け.種類
  会員           : bool  secret

outputs
  支払い   : string
  連絡用   : string

task 口座を取る(id: string) -> 銀行.Account
  connect 銀行 "AccountService/GetAccount"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/bank/1"

task 顧客を取る(id: string) -> 顧客情報
  http GET 顧客 "/customers/{id}"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/crm/1"

task サインインする(user: string, password: string) -> セッション
  http POST 顧客 "/sessions"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/crm/1"
  idempotent

task 払う(account_id: string, amount: int, note: string) -> 銀行.PayResponse
  connect 銀行 "PayoutService/Pay"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/bank/1"
  key

task 口座へ払う(account_number: string, amount: int) -> 銀行.PayResponse
  connect 銀行 "PayoutService/Pay"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/bank/1"
  key

task メモを残す(メモ: メモ)
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:file-note"
  idempotent

task 残す(値: json)
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:keep"
  idempotent

task まとめる(本文: string) -> string
  agent "本文が何についてのものかを、一文で答えてください。"
  model "gpt-5.4-mini"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/openai/1"
  discloses 本文 "プロバイダーとの取り決めで、データは残らない"

flow
  let 口座 = 口座を取る(id: 顧客番号)
  let 顧客 = 顧客を取る(id: 顧客番号)
  let セッション = サインインする(user: 顧客番号, password: APIトークン)
  let 行き先 = 振り分け(種類: 種類, 会員: 会員)
  let メモ: メモ = {宛先: 顧客.email, 本文: "{口座.holder} に支払いました"}
  メモを残す(メモ: メモ)
  for 一件 in 連絡先の一覧 at most 10
    残す(値: 一件)
  let トークン = [セッション.token, 顧客番号]
  残す(値: トークン)
  let まとめたもの: json = {token: APIトークン, 窓口: 行き先.窓口}
  残す(値: まとめたもの)
  残す(値: 行き先.期限)
  match 予備のトークン
    none => fail 予備なし "{顧客.email} の予備のトークンがありません"
    some t => 残す(値: t)
  let 要点 = まとめる(本文: 顧客.email)
  let 支払い = 払う(account_id: 口座.id, amount: 100, note: 要点)
  口座へ払う(account_number: 口座.branch, amount: 100)
  succeed 支払い = 支払い.paymentId, 連絡用 = 顧客.email
