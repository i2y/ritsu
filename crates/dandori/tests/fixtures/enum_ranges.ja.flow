workflow 列挙の範囲 v1
description "列挙の範囲：規則の、順序のある列挙の入力に範囲があるとき、ワークフローが渡す値は、どこから来るものでも、その範囲に入る値でなければならない"

use rule 送料 from "rules/会員段階の送料.rule"
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:member-tier-shipping"

record 会員
  名前 : string
  段階 : 送料.段階

inputs
  会員         : 会員
  キャンペーン : 送料.段階
  小計         : money[USD]  range >=0USD <=100000USD

outputs
  送料 : money[USD]

task キャンペーンを選ぶ(名前: string) -> 送料.段階
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:pick-campaign"
  idempotent

flow
  # 規則が会員を引き上げるのはゴールドまで。ゴールドは範囲の中、プラチナは外
  let a = 送料(会員: 会員.段階, キャンペーン: ゴールド, 小計: 小計)
  let b = 送料(会員: 会員.段階, キャンペーン: プラチナ, 小計: 小計)
  # 入力、レコードのフィールド、タスクの結果、規則の出力は、どれも列挙のどの値にもなりうる
  let c = 送料(会員: 会員.段階, キャンペーン: キャンペーン, 小計: 小計)
  let d = 送料(会員: 会員.段階, キャンペーン: 会員.段階, 小計: 小計)
  let 選んだ段階 = キャンペーンを選ぶ(名前: 会員.名前)
  let e = 送料(会員: 会員.段階, キャンペーン: 選んだ段階, 小計: 小計)
  let f = 送料(会員: 会員.段階, キャンペーン: a.適用段階, 小計: 小計)
  # それを入れた変数も同じ
  let 選ぶ段階 = キャンペーン
  let g = 送料(会員: 会員.段階, キャンペーン: 選ぶ段階, 小計: 小計)
  # キャンペーンで分けて、範囲に入る値を書いて渡せば、範囲の中に収まる
  match キャンペーン
    一般 => let h = 送料(会員: 会員.段階, キャンペーン: 一般, 小計: 小計)
    シルバー => let h = 送料(会員: 会員.段階, キャンペーン: シルバー, 小計: 小計)
    ゴールド, プラチナ => let h = 送料(会員: 会員.段階, キャンペーン: ゴールド, 小計: 小計)
  succeed 送料 = a.送料
