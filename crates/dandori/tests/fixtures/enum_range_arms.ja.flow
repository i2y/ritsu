workflow 分岐の中の列挙の範囲 v1
description "列挙の値を、その値の match の分岐の中で渡すと、そこでは分岐の値のどれかである。別の値を入れるまで、分岐の値が収まる場所に渡せる"

use rule 送料 from "rules/会員段階の送料.rule"
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:member-tier-shipping"

record 案内
  キャンペーン : 送料.段階  range >=一般 <=ゴールド

record 会員
  段階 : 送料.段階

inputs
  広い     : 送料.段階
  本人     : 会員
  無いかも : 送料.段階?
  ほかの人 : list[会員]
  小計     : money[USD]  range >=0USD <=100000USD

outputs
  最上位 : 送料.段階  range >=一般 <=ゴールド

task 送る(キャンペーン: 送料.段階  range >=シルバー <=ゴールド)
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:send"
  idempotent

task 選ぶ() -> 送料.段階
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:pick"
  idempotent

flow
  # 規則が受け取る値の分岐の中では、値は規則の入力に収まる
  match 広い
    プラチナ => pass
    一般, シルバー, ゴールド =>
      let a = 送料(会員: 広い, キャンペーン: 広い, 小計: 小計)
      # 分岐の中の分岐は、値をさらに絞る
      match 広い
        一般 => pass
        シルバー, ゴールド => 送る(キャンペーン: 広い)
      # 内側の分岐を出ると、外側の分岐のどの値にもなる。`一般` は収まらない
      送る(キャンペーン: 広い)
      let o: 案内 = {キャンペーン: 広い}
  # 分岐を出ると、どの値にもなる
  let b = 送料(会員: 広い, キャンペーン: 広い, 小計: 小計)
  # レコードのフィールドも同じ
  match 本人.段階
    プラチナ => pass
    一般, シルバー, ゴールド =>
      let c = 送料(会員: 広い, キャンペーン: 本人.段階, 小計: 小計)
  # 無いことがある値は、値がある分岐の中で読む
  match 無いかも
    none => pass
    some t =>
      match t
        プラチナ => pass
        一般, シルバー, ゴールド =>
          let d = 送料(会員: t, キャンペーン: t, 小計: 小計)
  # match のあとで別の値を入れると、分岐はもう値を絞らない
  let 選んだ段階 = 広い
  match 選んだ段階
    プラチナ => pass
    一般, シルバー, ゴールド =>
      let 選んだ段階 = 選ぶ()
      let e = 送料(会員: 広い, キャンペーン: 選んだ段階, 小計: 小計)
  # ループの中で値を入れる変数は、ループの中でもあとでも絞らない
  let 順番 = 広い
  match 順番
    プラチナ => pass
    一般, シルバー, ゴールド =>
      for 一人 in ほかの人 at most 5
        let f = 送料(会員: 広い, キャンペーン: 順番, 小計: 小計)
        let 順番 = 一人.段階
      let g = 送料(会員: 広い, キャンペーン: 順番, 小計: 小計)
  # 分岐が合わさったあとの文では、そこへ来る分岐のどの値にもなる
  match 広い
    一般 => pass
    シルバー => pass
    ゴールド, プラチナ => succeed 最上位 = ゴールド
  送る(キャンペーン: 広い)
  succeed 最上位 = 広い
