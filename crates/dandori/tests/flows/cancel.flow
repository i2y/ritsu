workflow 取消 v1
description "キャンセルの端の振る舞い：案件を片付ける on cancel、やり直しと受けを素通りするキャンセル、並列の回の中のキャンセル、コールバックを待つあいだのキャンセル、on failure の最中のキャンセル。Temporal 向け"

use rule 注文の状態 from "../../examples/order/rules/注文の状態.rule"

record 注文
  id   : string
  状態 : 注文の状態.状態

record 受付
  id : string

inputs
  注文ID   : string
  品目たち : list[string]

task 注文を見る(id: string) -> 注文
  observes
  idempotent

# A cancellation is not a failure: neither the retry nor `on failure` takes it.
task 引き当てる(品目: string) -> 受付
  idempotent
  retry 1 times

task 取消を頼む(id: string) -> 注文
  sends 取消依頼
  errors 断られた
  refused as 断られた
  key

task 知らせる(注文ID: string, 本文: string) -> 受付
  key

# The warehouse answers when the carrier reports the delivery.
task 配達を待つ(id: string) -> 注文
  callback
  observes
  timeout 7 days

case 受注 : 注文 follows 注文の状態.注文
  external 入金, 配達, 取消依頼
  refused when 受理 = false

flow
  受注 <- 注文を見る(id: 注文ID)
  let 引当 = for 品目 in 品目たち at most 3 in parallel
    let r = 引き当てる(品目: 品目)
      on failure => fail NotReserved "{品目} を引き当てられませんでした" leaving 受注
    yield r.id
  受注 <- 配達を待つ(id: 受注.id)
    on timeout => fail DeliveryLate "七日たっても配達の知らせがありません" leaving 受注
  match 受注.状態
    配達済, 取消 => pass
    受付, 入金済, 出荷済 => fail NotDelivered "配達されていません" leaving 受注

on failure
  知らせる(注文ID: 注文ID, 本文: "注文 {注文ID} の処理が止まりました")
    on failure => pass
  fail Stopped "途中で止まりました" leaving 受注

# Wherever the cancellation comes, the order that is not yet shipped is cancelled at the warehouse.
on cancel
  match 受注.状態
    none => pass
    受付, 入金済 =>
      受注 <- 取消を頼む(id: 受注.id)
        on 断られた => pass
        on failure => fail CancelFailed "注文 {受注.id} を取り消せませんでした" leaving 受注
      知らせる(注文ID: 受注.id, 本文: "注文 {受注.id} を取り消しました")
        on failure => pass
    出荷済 => fail ShippedAlready "注文 {受注.id} はもう出荷されています" leaving 受注
    配達済, 取消 => pass
