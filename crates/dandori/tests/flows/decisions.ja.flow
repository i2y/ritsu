workflow 判断 v1
description "判断のタスクを三つの送り先で：TypeSafe の Jev、System One の API のサーバー（`url`。Ollama など）、OpenAI の Decisions API（`jev openai`）とそのほかのサーバー（`url`）。一部の値にだけ意味を書いた choice、score、意味を書いたはいかいいえと書かないもの、一回のリクエストで三つに答え、そのうち一つの確信度を率で受け取るレコード、確信度の下限、宣言した拒否と宣言しない拒否（どちらも、呼び出しで処理するものとしないもの）、結果を読まない呼び出し、ステータスで宣言したエラーのリトライ、W032 の二つの形（System One の API のサーバーのタグの無いモデルと、モデルのバージョンを固定する名前の無い Decisions API）"

enum 種類 = 返品 | 配送 | 請求 | その他
enum 急ぎ = 低 | 中 | 高

record 読み
  種類   : 種類
  急ぎ   : 急ぎ
  人     : bool
  確かさ : rate[step 0.01%]

inputs
  問い合わせ : list[string]
  本文       : string
  会員       : bool

outputs
  一通ごとの種類 : list[種類]
  種類           : 種類
  急ぎ           : 急ぎ
  人             : bool
  怒り           : bool
  確かさ         : rate[step 0.01%]

# TypeSafe の Jev。意味を書かない値は、意味なしの選択肢として送る
task 種類を選ぶ(本文: string) -> 種類
  jev "この問い合わせの種類はどれか"
    返品 "商品を返したい、交換したい"
    配送 "荷物が届かない、遅れている、壊れていた"
  model "jev-1.13.0"
  confidence 0.8 else 迷い
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/typesafe/1a2b3c4d"
  errors 混雑 = 429, 過負荷 = 529
  retry 2 times every 1 second on 混雑, 過負荷
  timeout 10 seconds

# System One の API のサーバー（Ollama は /v1/systemone で受ける）。モデルはタグまで書く
task 急ぎを測る(本文: string, 種類: 種類) -> 急ぎ
  jev score "お客さまはどれほど急いでいるか"
    低 "急ぎを伝えていない"
    中 "期日を挙げているが、差し迫ってはいない"
    高 "今日中の対応を求めている"
  model "tev1:0.8b"
  url "https://decisions.example.com/v1"
  confidence 0.7 else 測れない
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/decisions/5e6f7a8b"
  errors 混雑 = 429
  retry 1 times every 1 second on 混雑

# 同じサーバーの、タグの無いモデル。サーバーが取り直すと別のモデルに移る（W032）
task 人を求める(本文: string, 会員: bool) -> bool
  jev "お客さまは人の担当者と話したいと言っているか"
    true "担当者や人と話したいとはっきり書いている"
    false "そうは書いていない"
  model "nimble"
  url "https://decisions.example.com/v1/"
  confidence 0.9 else 分からない
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/decisions/5e6f7a8b"

# OpenAI の Decisions API。一回のリクエストで三つに答え、種類の確信度を受け取る。拒否を宣言する。
# この API にはモデルのバージョンを固定する名前が無い（W032）
task 読む(本文: string) -> 読み
  jev openai
    種類 "この問い合わせの種類はどれか"
      返品 "商品を返したい、交換したい"
      請求 "請求や支払いのこと"
    急ぎ score "お客さまはどれほど急いでいるか"
      低 "急ぎを伝えていない"
      中 "期日を挙げているが、差し迫ってはいない"
      高 "今日中の対応を求めている"
    人 "お客さまは人の担当者と話したいと言っているか"
    確かさ confidence of 種類
  model "gpt-6-luna"
  confidence 0.6 else 自信なし
  refusal else 答えない
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/openai/9c0d1e2f"
  errors 混雑 = 429
  retry 2 times every 1 second on 混雑
  timeout 10 seconds

# Decisions API のほかのサーバー（`url`）。はいかいいえで尋ね、拒否は宣言しない。答えなかった
# 質問は Dandori.Refused で失敗し、`on failure` が受ける
task 怒っている(本文: string) -> bool
  jev openai "お客さまは怒っているか"
  model "gpt-6-luna"
  url "https://gateway.example.com/v1"
  connection "arn:aws:events:ap-northeast-1:123456789012:connection/gateway/3a4b5c6d"

flow
  # 結果は読まないが、確信度は確かめる
  人を求める(本文: 本文, 会員: 会員)
    on 分からない => pass
  let 一通ごとの種類 = for 一通 in 問い合わせ at most 3 in parallel
    let k = 種類を選ぶ(本文: 一通)
      on 迷い => let k = その他
    yield k
  let 種類 = 種類を選ぶ(本文: 本文)
    on 迷い => let 種類 = その他
  let 急 = 急ぎを測る(本文: 本文, 種類: 種類)
    on 測れない => let 急 = 高
  let 読み = 読む(本文: 本文)
    on 答えない => fail 読み取れない "モデルが問い合わせを読みませんでした"
  let 怒り = 怒っている(本文: 本文)
    on failure => let 怒り = true
  # 呼び出しで処理しない拒否は、結果を読まなくても on failure へ行く
  怒っている(本文: 本文)
  succeed 一通ごとの種類 = 一通ごとの種類, 種類 = 種類, 急ぎ = 急, 人 = 読み.人, 怒り = 怒り, 確かさ = 読み.確かさ

on failure
  fail 読めない "問い合わせを読み取れませんでした"
