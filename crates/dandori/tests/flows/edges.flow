workflow edges v1
description "言語のエッジケース：配列の json をリストに入れる、yield した json を集める、並列の中の並列、理由の無い fail"

record 箱
  中身   : json
  ラベル : string?

record 答え
  id   : string
  付帯 : json

inputs
  箱   : list[箱]
  一つ : json

outputs
  集め : list[json]

task 見る(中身: json) -> 答え
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:look"
  idempotent

task 置く(中身: json)
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:put"
  idempotent

flow
  置く(中身: [一つ, 一つ])
  let 集め = for 一箱 in 箱 at most 3 in parallel
    let 答え = 見る(中身: 一箱.中身)
    for 小箱 in 箱 at most 3 in parallel
      match 小箱.ラベル
        some ラベル => 置く(中身: {ラベル: ラベル})
        none => fail NoLabel
    yield 答え.付帯
  let 順に = for 箱2 in 箱 at most 3
    yield 箱2.中身
  置く(中身: 順に)
  succeed 集め = 集め
