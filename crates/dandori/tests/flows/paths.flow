workflow paths v1
description "The arguments an HTTP task puts into its URL: a `/`, `?`, `#`, `%`, a space or text that is not ASCII stays inside its segment, from a literal, a string with values in it, a number and an optional value"

inputs
  item  : string
  count : int
  tag   : string?

outputs
  found : string

# Each argument in the URL is escaped as encodeURIComponent escapes it.
task look(item: string, count: int, tag: string?) -> string
  http GET "https://items.example.com/v1/items/{item}/counts/{count}/tags/{tag}"
  connection "arn:aws:events:us-east-1:123456789012:connection/items/1"
  idempotent

flow
  let a = look(item: "a/b c?d#e%f&g=h+i'(j)*!~é品", count: count, tag: tag)
  let b = look(item: "{item}/{a} 100%", count: 7, tag: "x/y")
  succeed found = "{a} {b}"
