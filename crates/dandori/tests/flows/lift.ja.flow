workflow 引き上げ v1
description "キャンペーンは、その注文に限って会員の段階を引き上げる。引き上げられるのは、規則が受け付けるゴールドまで。ワークフローは、受け取ったキャンペーン、注文のキャンペーン、タスクが選んだキャンペーンを、入ってくるところでその範囲に収め、そのまま規則に渡す。どのプラットフォームでも走る"

use rule 送料 from "rules/会員段階の送料.rule"
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:member-tier-shipping"

record 注文
  番号         : string
  キャンペーン : 送料.段階  range >=一般 <=ゴールド
  小計         : money[USD]  range >=0USD <=100000USD

inputs
  会員         : 送料.段階
  キャンペーン : 送料.段階  range >=一般 <=ゴールド
  注文         : 注文

outputs
  引き上げ   : bool
  送料       : money[USD]
  勧めた段階 : 送料.段階  range >=シルバー <=ゴールド

task キャンペーンを選ぶ(会員: 送料.段階) -> 送料.段階  range >=シルバー <=ゴールド
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:pick-campaign"
  idempotent

task 案内を送る(注文: string, キャンペーン: 送料.段階  range >=一般 <=ゴールド)
  lambda "arn:aws:lambda:ap-northeast-1:123456789012:function:send-offer"
  key

flow
  # 受け取ったキャンペーンは、入ってくるところで規則の範囲に収めてある
  let 見積もり = 送料(会員: 会員, キャンペーン: キャンペーン, 小計: 注文.小計)
  # 注文のキャンペーンも、レコードのフィールドとして範囲に収めてある
  let 注文の見積もり = 送料(会員: 会員, キャンペーン: 注文.キャンペーン, 小計: 注文.小計)
  # 範囲に収めた値の match は、範囲に入る値だけで分ける
  match キャンペーン
    一般 => 案内を送る(注文: 注文.番号, キャンペーン: 一般)
    シルバー, ゴールド => 案内を送る(注文: 注文.番号, キャンペーン: キャンペーン)
  # タスクが選んだキャンペーンは、結果の範囲に収めてある
  let 選んだ段階 = キャンペーンを選ぶ(会員: 会員)
  let 勧め = 送料(会員: 会員, キャンペーン: 選んだ段階, 小計: 注文.小計)
  succeed 引き上げ = 勧め.引き上げ, 送料 = 勧め.送料, 勧めた段階 = 選んだ段階
