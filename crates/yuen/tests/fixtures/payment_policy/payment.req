requirements payment_terms v1
description "A test material: a requirement with two versions, a replacement, and a requirement read from one of another file. The terms are decided for the example; they are not real payment terms"

scope file "src"

requirement month_end_close
  text "Invoices close at the end of the month"
  in force 2026-01-01..2027-03-31
  owner accounting
  decided 2025-12-01 by accounting "Closing is made the end of the month. Decided for this material"
  satisfied by file "src/close.py"
    reviewed 2026-10-03 by development sha256:57e93b89b6e853e5 -> sha256:9bb0abb20fa56cb7
  not verified "The closing day only returns the last date of the month, so no claim is set to check it"
    approved 2026-10-03 by accounting sha256:57e93b89b6e853e5

requirement payment_day v1
  text "Closes at the end of the month, pays at the end of the next month"
  in force 2026-01-01..2027-03-31
  owner accounting
  from payment_policy
    reviewed 2026-10-03 by accounting sha256:0a46828266bf9f74 -> sha256:d78a1ef755846010
  satisfied by file "src/pay.py"
    reviewed 2026-10-03 by development sha256:d78a1ef755846010 -> sha256:93e39b25842afd07
  verified by file "tests/test_pay.py"
    reviewed 2026-10-03 by development sha256:d78a1ef755846010 -> sha256:df4a7416b584ec48

requirement payment_day v2
  text "Closes on the 20th, pays on the 10th of the next month"
  in force 2027-04-01..
  owner accounting
  replaces month_end_close
  from payment_policy
    reviewed 2026-10-03 by accounting sha256:0a46828266bf9f74 -> sha256:86e2461203be3e7c
  decided 2026-10-03 by accounting "From April 2027 the closing day moves to the 20th. Decided for this material"
  satisfied by file "src/pay.py"
    reviewed 2026-10-03 by development sha256:86e2461203be3e7c -> sha256:93e39b25842afd07
  verified by file "tests/test_pay.py"
    reviewed 2026-10-03 by development sha256:86e2461203be3e7c -> sha256:df4a7416b584ec48
