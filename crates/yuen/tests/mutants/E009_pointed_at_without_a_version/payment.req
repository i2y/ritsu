requirements payment v1
description "A test material. The rules are decided for the example, and are no company's"

role accounting "Decides the rules of payment"
role development "Writes the code"

requirement payment_day v1
  text "Closes on the 20th, pays on the 10th of the next month"
  in force 2026-01-01..2027-03-31
  owner accounting
  decided 2026-10-03 by accounting "decided for the example"
  satisfied by file "pay.py"
  not verified "Accounting compares them once a month"

requirement payment_day v2
  text "Closes at the end of the month, pays at the end of the next month"
  in force 2027-04-01..
  owner accounting
  decided 2026-10-03 by accounting "decided for the example"
  satisfied by file "pay.py"
  not verified "Accounting compares them once a month"

requirement transfer_day
  text "Transfers on the business day before the payment day"
  owner accounting
  from payment_day
  satisfied by file "pay.py"
  not verified "Accounting compares them once a month"
