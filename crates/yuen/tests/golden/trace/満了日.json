              "text": [
                "（期間の満了）",
                "第百四十一条　前条の場合には、期間は、その末日の終了をもって満了する。"
              ]
            },
            {
              "source": "民法",
              "fragment": "第143条",
              "db": "egov",
              "id": "129AC0000000089",
              "asof": "2026-10-01",
