            <ATTRIBUTE-VALUE-STRING THE-VALUE="legal">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_3066d61d13e61978b5093daf3448f446</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>_10b2c8aa7aa8351e17bc9aa38f52880f</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><xhtml:div>decided 2026-10-03 by legal "The period starts on the day after the origin. Decided for this material"</xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>_7ffe71e9e8ed2f78b159d299efe86c10</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>not verified "That the first day is not counted is checked on koyomi doc's page, by reading the rule and its restatement side by side. This material has no claim that checks it"</xhtml:p><xhtml:p>approved 2026-10-04 by legal sha256:29836b1424129486</xhtml:p></xhtml:div></THE-VALUE>
