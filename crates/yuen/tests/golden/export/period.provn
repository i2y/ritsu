  activity(y:waiver/08936d68b645676a66a10ffc473a33de, 2026-10-03T00:00:00, -, [prov:type='yuen:Waiver', yuen:side="not verified", yuen:why="条文の場合分けをそのまま書いた関数と、起点 2000〜2027 年のすべての日と月数 1〜12 で一致することを、koyomi の設計の段階の試作が確かめた。この材料の中に、それを確かめる条件は無い", yuen:sha256="465b83ed8c251406", yuen:status="ok"])
