            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>_82a6d3ab90a94a7ccf25b592606a5115</SPEC-OBJECT-TYPE-REF></TYPE>
