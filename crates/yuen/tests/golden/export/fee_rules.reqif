            <ATTRIBUTE-VALUE-STRING THE-VALUE="cfr §1.27">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_d25e08f6214748c0cd1d68fa1f87b80a</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
