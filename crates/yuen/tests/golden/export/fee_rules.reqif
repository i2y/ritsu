        <SPEC-RELATION IDENTIFIER="_3901c22902a1dde8e9cf9f0a16a4644d" LAST-CHANGE="2026-10-04T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="2026-10-04">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_309e5c9fc4d3093cabfe553f89398883</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
