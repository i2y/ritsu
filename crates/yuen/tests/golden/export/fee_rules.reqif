      <SPEC-OBJECTS>
        <SPEC-OBJECT IDENTIFIER="_4fae5720535f493ba47c1bc02fc70094" LAST-CHANGE="2026-10-04T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="standard_fee v1">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_0e55a1623323e7efaa94ed254185f196</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>_86e2773d004ee20e74aa766f2ce351f3</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><xhtml:div>standard_fee</xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>_53c969acbb77c12b793b52095a0ca59c</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><xhtml:div>The fee for an extension of time to reply is set by the month of the reply, from the first to the fifth, and no fee is charged when no extension is taken</xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="2026-01-01..">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_ca9ff16428087823eedc317e47afc0da</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="legal">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_3066d61d13e61978b5093daf3448f446</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>_7ffe71e9e8ed2f78b159d299efe86c10</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>not verified "That the table covers every month and that its rows do not overlap is checked by rulec. This material has no claim that names it"</xhtml:p><xhtml:p>approved 2026-10-04 by legal sha256:717b0eb89e528849</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="717b0eb89e528849">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_3053884aad8bf228da5264102c7adaac</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
