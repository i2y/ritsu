    "y:requirement/timely_filing/v1": {
      "prov:type": {
        "$": "yuen:Requirement",
        "type": "prov:QUALIFIED_NAME"
      },
      "prov:label": "timely_filing",
      "yuen:version": "1",
      "yuen:text": "Correspondence required to be filed within a set period of time is considered timely filed if it is mailed or transmitted before the period ends, with a certificate of the date of deposit or transmission",
      "yuen:inForce": "2026-10-01..",
      "yuen:sha256": "8d02c6a1f0ad3364"
    },
    "y:requirement/next_business_day/v1": {
