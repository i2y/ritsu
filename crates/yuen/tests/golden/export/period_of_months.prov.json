        "type": "prov:QUALIFIED_NAME"
      },
      "prov:label": "next_business_day",
      "yuen:version": "1",
      "yuen:text": "When the last day fixed for taking an action falls on a Saturday, Sunday or Federal holiday, the action may be taken on the next succeeding business day which is not one",
