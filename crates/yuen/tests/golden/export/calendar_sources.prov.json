    "y:requirement/payment_day/v1": {
      "prov:type": {
        "$": "yuen:Requirement",
        "type": "prov:QUALIFIED_NAME"
      },
      "prov:label": "payment_day",
      "yuen:version": "1",
      "yuen:text": "Closes on the 20th, pays on the 10th of the next month. When the payment day is closed, pays on the business day before",
      "yuen:inForce": "2026-10-01..",
      "yuen:sha256": "dd7089d2bc2f76e0"
    },
    "y:requirement/first_day/v1": {
      "prov:type": {
        "$": "yuen:Requirement",
        "type": "prov:QUALIFIED_NAME"
      },
      "prov:label": "first_day",
      "yuen:version": "1",
      "yuen:text": "The day itself is not counted",
      "yuen:inForce": "2026-10-01..",
      "yuen:sha256": "29836b1424129486"
    },
    "y:requirement/last_day/v1": {
      "prov:type": {
        "$": "yuen:Requirement",
        "type": "prov:QUALIFIED_NAME"
      },
      "prov:label": "last_day",
      "yuen:version": "1",
      "yuen:text": "A period of months ends on the day before the corresponding day of the last month, or on the last day of that month when it has no such day",
      "yuen:inForce": "2026-10-01..",
      "yuen:sha256": "534cb97e1ca8a94c"
    },
    "y:requirement/last_day_moved/v1": {
      "prov:type": {
        "$": "yuen:Requirement",
        "type": "prov:QUALIFIED_NAME"
      },
      "prov:label": "last_day_moved",
      "yuen:version": "1",
      "yuen:text": "An end that falls on a day closed in England and Wales moves to the day after",
      "yuen:inForce": "2026-10-01..",
      "yuen:sha256": "edc4cc0bb4910f57"
    }
