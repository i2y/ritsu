    "y:requirement/travel_distance/v1": {
      "prov:type": {
        "$": "yuen:Requirement",
        "type": "prov:QUALIFIED_NAME"
      },
      "prov:label": "travel_distance",
      "yuen:version": "1",
      "yuen:text": "Portable fire extinguishers for Class A hazards are placed so that the travel distance to any extinguisher is 75 feet or less, and for Class B hazards 50 feet or less",
      "yuen:inForce": "2026-01-01..",
      "yuen:sha256": "849dc53f1d112c23"
    },
    "y:requirement/base_tax/v1": {
      "prov:type": {
        "$": "yuen:Requirement",
        "type": "prov:QUALIFIED_NAME"
      },
      "prov:label": "本則の税額",
      "yuen:version": "1",
      "yuen:text": "不動産の譲渡に関する契約書の印紙税額は、記載された契約金額に応じて、別表第一の第1号文書の欄の税率による。契約金額が1万円未満のものは課税しない",
      "yuen:inForce": "2026-04-01..",
      "yuen:sha256": "56d4ef0ae01ebb19"
    },
    "y:requirement/reduced_rate/v1": {
      "prov:type": {
        "$": "yuen:Requirement",
        "type": "prov:QUALIFIED_NAME"
      },
      "prov:label": "軽減税率",
      "yuen:version": "1",
      "yuen:text": "令和9年3月31日までに作成される不動産の譲渡に関する契約書の印紙税額は、租税特別措置法第91条の軽減された税率による",
      "yuen:inForce": "2026-04-01..",
      "yuen:sha256": "c3fbde1529c44e2e"
    }
  },
