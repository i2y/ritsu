  requester e1101
  form what = "A projector", shape = between
| at               | event                                  | by    | -> stage | status      |
| 2026-11-16 10:00 | submit                                 | e1101 | middle   | in progress |
| 2026-11-16 11:00 | approve                                | e1001 | second   | in progress |
| 2026-11-16 12:00 | add approver(approver: person "e0102") |       | second   | in progress |
| 2026-11-16 13:00 | approve                                | e3101 | decide   | in progress |

# an approver's edit takes the later stage off the route: the stage that waited starts then
scenario the_later_stage_leaves_the_route
  requester e1101
  form what = "A projector", shape = between
| at               | event              | by    | -> stage | status      |
| 2026-11-16 10:00 | submit             | e1101 | middle   | in progress |
| 2026-11-16 11:00 | edit(shape: short) | e1001 | middle   | in progress |
| 2026-11-16 12:00 | approve            | e1001 | first    | in progress |
| 2026-11-16 13:00 | approve            | e3101 | decide   | in progress |

# an approver's edit gives the later stage to another: the stage that waited starts before it
scenario the_later_stage_comes_to_another
