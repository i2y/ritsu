request example v1 "Example"

form
  amount : money[JPY] "Amount"  range >=1JPY <=100_000JPY
  limit  : money[JPY] "Limit"  range >=1JPY <=100_000JPY

route
  check  finance
  audit  board    when amount is limit

who
  finance = team finance
  board   = team board

ticket
  self approval  not allowed
