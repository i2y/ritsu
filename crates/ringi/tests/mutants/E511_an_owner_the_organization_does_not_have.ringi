request outlay v1 "Outlay"
description "An outlay a person in sales asks for, which the manager checks (fictional). Accounting keeps it, and the organization has no such team"
owner accounting

use organization org from "shared/small.ringi"

form
  amount : money[JPY] "Amount"  range >=1JPY <=100_000JPY

route
  check  manager

who
  manager = manager of requester

ticket
  submitted by   everyone in sales
  self approval  not allowed
