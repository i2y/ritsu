rule authority v1
description "金額で決める決裁者（架空）"

enum decider = manager "Manager" | cfo "Chief financial officer"

inputs
  amount : money[JPY]  range >=1JPY <=100_000JPY

outputs
  decider : decider

table decider
| amount      | -> decider |
| <=50_000JPY | manager    |
| >50_000JPY  | cfo        |
