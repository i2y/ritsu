request 支出(outlay) v1 "支出"

use organization 組織(org) from "shared/小さい会社.ringi"

form
  種別(category) : choice "種別"
    出張(travel)   "出張"
    備品(supplies) "備品"
  明細(items) : rows "明細"  count >=1 <=10
    品目(what)  : text "品目"  count <=100
    金額(price) : money[円] "金額"  range >=1円 <=100_000円
  合計(amount) : money[円] "合計" = sum(明細.金額)  range >=1円 <=1_000_000円

route
  確かめ(check)  上長

who
  上長(manager) = manager of requester

ticket
  self approval  not allowed

labels en
  request       "Outlay"
  種別           "Category"
  種別.出張      "Travel"
  種別.備品      "Supplies"
  明細           "Items"
  明細.品目      "What"
  合計           "Amount"
  stage 確かめ   "Check"
  who 上長       "Manager"
