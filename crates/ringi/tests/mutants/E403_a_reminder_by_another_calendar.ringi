request example v1 "Example"

use calendar office from "shared/office.cal"
use calendar plant from "shared/plant.cal"

form
  amount : money[JPY] "Amount"  range >=1JPY <=100_000JPY

route
  check  finance

who
  finance = team finance

every stage
  due in 2 business days in office at end of day
  remind after 2 business days in plant at 09:00

ticket
  self approval  not allowed

claims
  reminded_in_time : every stage reminds before it is due
