request 例(example) v1 "例"

use calendar 事務所(office) from "shared/事務所.cal"
use book 予算(budget) from "shared/budget.book"

form
  金額(amount) : money[JPY] "金額"  range >=1JPY <=100_000JPY
  部(dept)     : text "部"  count >=1 <=20
  種別(kind)   : choice "種別"
    予算(budgeted)  "予算から"
    無償(free)      "費用なし"

route
  確かめ(check)  経理

who
  経理(finance) = team finance

every stage
  due in 3 business days at end of day
  when late expire

ticket
  self approval   not allowed
  approvers edit  種別
  on submitted    hold 予算.reserve(request: ticket.id, attempt: ticket.attempt, dept: 部, amount: 金額)  when 種別 is 予算
  on approved     post 予算.reserve(request: ticket.id, attempt: ticket.attempt)  when 種別 is 予算
  on rejected, expired  void 予算.reserve(request: ticket.id, attempt: ticket.attempt)  when 種別 is 予算
