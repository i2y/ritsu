rule contract_route v1
description "What ringi writes from the route of contract.ringi: one optional output for each stage, whose value is the approver the stage names; a blank cell is none, the stage is not there"

import enum kind from "choices.rule"
enum manager_by = manager_approver "manager"
enum summary_by = note_from_summarize "note from summarize"
enum intake_by = legal "legal"
enum review_by = reviewer "reviewer"
enum second_by = at_least_2_of_legal "at least 2 of legal"
enum counsel_by = counsel_approver "counsel"
enum finance_by = circulate_to_finance "circulate to finance"

inputs
  value : money[JPY]  range >=0JPY <=1_000_000_000JPY
  kind  : kind

outputs
  manager : manager_by
  summary : summary_by
  intake  : intake_by
  review  : review_by
  second  : second_by?
  counsel : counsel_by?
  finance : finance_by?

table manager
| -> manager       |
| manager_approver |

table summary
| -> summary          |
| note_from_summarize |

table intake
| -> intake |
| legal     |

table review
| -> review |
| reviewer  |

table second
| value          | -> second           |
| <=5_000_000JPY | none                |
| >5_000_000JPY  | at_least_2_of_legal |

table counsel
| value           | -> counsel       |
| <=10_000_000JPY | none             |
| >10_000_000JPY  | counsel_approver |

table finance
| kind         | -> finance           |
| not: license | none                 |
| license      | circulate_to_finance |
