rule contract_ja_values v1
description "What ringi writes from the form of contract.ja.ringi for the code it generates: the totals and computations over all the values what they read can take, and when a field is shown and asked for; the code holds each computation to its range"

import enum kind from "choices.rule"

inputs
  kind : kind

outputs
  risks_shown : bool

table risks_shown
| kind     | -> risks_shown |
| nda      | false          |
| not: nda | true           |
