rule leave_ja_route v1
description "What ringi writes from the route of leave.ja.ringi: one optional output for each stage, whose value is the approver the stage names; a blank cell is none, the stage is not there"

enum manager_by = manager_approver "manager"
enum head_by = dept_head "dept_head"

inputs
  days : number  range >=1 <=20

outputs
  manager : manager_by
  head    : head_by?

table manager
| -> manager       |
| manager_approver |

table head
| days | -> head   |
| <=5  | none      |
| >5   | dept_head |
