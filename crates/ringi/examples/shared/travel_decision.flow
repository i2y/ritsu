workflow travel_decision v1
  now range >=2026-01-01 <=2027-12-31 offset +09:00
description "The agent's decision on a travel expense of 30,000 yen or less, on the rows the route of expense.ringi gives the agent: ok approves it, doubt hands it to the requester's manager with the reason. ringi starts it and reads its outputs as the answer of the stage"

enum Check = ok | doubt

record Reading
  verdict : Check
  reason  : string

inputs
  request_id : string
  amount     : money[JPY]  range >=1JPY <=30_000JPY
  purpose    : string
  trip_to    : string

outputs
  verdict : Check
  reason  : string

task decide(amount: money[JPY], purpose: string, trip_to: string) -> Reading
  agent claude "You decide a travel expense of 30,000 yen or less under the travel rules. Answer ok to approve it; answer doubt, with the reason in one sentence, when anything in it needs a person"
  model "claude-sonnet-5"
  effort low
  timeout 60 seconds
  retry 2 times every 10 seconds

flow
  let r = decide(amount: amount, purpose: purpose, trip_to: trip_to)
    on failure, timeout => let r = {verdict: doubt, reason: "The agent could not decide the request"}
  succeed verdict = r.verdict, reason = r.reason
