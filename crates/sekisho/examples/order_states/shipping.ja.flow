workflow 発送 v1
description "支払い済みの注文を発送し、注文の状態を返す。状態は、ゲートも読む enums のファイルから読む。shipping.flow の日本語の版"

import enum 注文の状態 from "rules/注文の状態.rule"

task 発送済みにする(注文ID: string)

inputs
  注文ID : string
  状態   : 注文の状態

outputs
  状態 : 注文の状態

flow
  match 状態
    支払済 =>
      発送済みにする(注文ID: 注文ID)
      succeed 状態 = 発送済
    発送済 => succeed 状態 = 発送済
    返品済 => succeed 状態 = 返品済
    返金済 => succeed 状態 = 返金済
