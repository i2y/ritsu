gate claims v2
description "Who may pay a claim: the desk's workflow pays a claim up to 500 yen"
namespace Claims

use openapi desk from "../../examples/claims/api/desk.json"

workflow pay from "flows/pay.flow"
  description "Pays a claim"
  resource Claim from claim_id
    amount = asked
    rush   = rush

resource Claim
  description "A claim"
  attributes
    amount  : money[JPY]  range >=1JPY <=10_000JPY
    checked : bool
    rush    : bool

action pay_claim
  description "Pay a claim"
  guards desk payClaim
  principal Workflow
  resource Claim from claimId

permit the_workflow_pays_small_claims
  description "The workflow pays a claim up to 500 yen"
  principal is workflow pay
  action pay_claim
  when resource.amount <= 500JPY
