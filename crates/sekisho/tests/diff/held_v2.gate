gate held v2
description "Refunds by the band of a rule, its second version: a clerk refunds an amount the rule calls small, and nothing from 4"
namespace Shop

use rule band from "band.rule"

role clerk
  description "Answers customers"

principal User
  description "A member of the staff"
  roles clerk

resource Order
  description "An order of the shop"

action refund_order
  description "Refund an order"
  principal User
  resource Order
  input
    amount : number  range >=1 <=20
  context
    size = band(amount: amount).band

permit clerks_refund_small_amounts
  description "A clerk refunds an amount the rule calls small"
  principal in clerk
  action refund_order
  when size is small

forbid nothing_from_4
  description "Nothing is refunded from 4"
  principal is User
  action refund_order
  when amount >= 4
