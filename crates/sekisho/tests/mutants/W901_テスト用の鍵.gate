gate 地図(maps) v1
description "地図の上の場所を見てよい人"

# テストが地図を描くときのキー: AIzaSyD-ritsu-fake-key-for-tests-000000   # ritsu: test secret
# 店のキー（テスト用ではない）: AIzaSyD-ritsu-fake-key-for-tests-000000
role 係(clerk)
  description "客に応対する"

principal 職員(User)
  description "店の職員"
  roles 係

resource 場所(Place)
  description "地図の上の場所"

action 場所を見る(view_place)
  description "場所を見る"
  principal 職員
  resource 場所

permit 係は場所を見られる(clerks_view)
  description "係はどの場所も見られる"
  principal in 係
  action 場所を見る
