gate 店(shop) v1
description "店の注文をだれが見られるか"
namespace ShopJa

enum 状態(order_status) = 支払済(paid) | 発送済(shipped) | 返品済(returned) | 返金済(refunded)
import enum 状態 from "read/注文の状態.rule" -> 分け合う状態(shared_status)

role 係(clerk)
  description "お客さまに答える"
  can 注文を見る

principal 職員(User)
  description "店の職員"
  roles 係

resource 注文(Order)
  description "店の注文"
  attributes
    状態(status)       : 状態
    求める状態(asked) : 分け合う状態

action 注文を見る(view_order)
  description "注文を見る"
  principal 職員
  resource 注文

permit 職員は求める状態の注文を見る(staff_view_orders_in_the_status_asked)
  description "職員は、求められた状態にある注文を見る"
  principal in 係
  action 注文を見る
  when resource.状態 is resource.求める状態
