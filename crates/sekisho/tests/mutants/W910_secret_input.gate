gate loans v1
description "Who may open a loan"

use openapi loans from "loans.json"

role officer
  description "Opens loans"

principal User
  description "A member of the staff"
  roles officer

resource Loan
  description "A loan"

action open_loan
  description "Open a loan"
  guards loans openLoan
  principal User
  resource Loan
  input
    credit_score : number  range >=0 <=999

permit officers_open_loans_for_good_scores
  description "An officer opens a loan for a credit score of 600 or more"
  principal in officer
  action open_loan
  when credit_score >= 600
