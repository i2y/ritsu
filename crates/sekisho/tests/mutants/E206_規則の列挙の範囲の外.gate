gate 段階(tiers_ja) v1
description "tests/walk/ranges/tiers.ja.gate のキャンペーンが、規則の受け取る範囲のゴールドを超えるもの。プラチナまである列挙の属性と、定数のプラチナを渡す"
namespace ShopJa

use rule キャンペーンの引き上げ from "../walk/ranges/キャンペーンの引き上げ.rule"

enum 段階(tier) = 一般(basic) | シルバー(silver) | ゴールド(gold) | プラチナ(platinum)

principal 会員(User)
  description "店の会員"
  attributes
    段階(tier) : 段階

resource 注文(Order)
  description "注文と、その注文のキャンペーン"
  attributes
    キャンペーン(campaign) : 段階

action 引き上げて送る(ship_lifted)
  description "キャンペーンが会員を引き上げる段階で、注文を送る"
  principal 会員
  resource 注文
  context
    引き上げる(lifted) = キャンペーンの引き上げ(会員: principal.段階, キャンペーン: resource.キャンペーン).引き上げ

action プラチナで送る(ship_at_platinum)
  description "注文をプラチナの段階で送る"
  principal 会員
  resource 注文
  context
    上がる(raised) = キャンペーンの引き上げ(会員: principal.段階, キャンペーン: プラチナ).引き上げ

permit キャンペーンが引き上げる注文(orders_a_campaign_lifts)
  description "キャンペーンが会員を引き上げる注文は、キャンペーンの段階で送る"
  principal is 会員
  action 引き上げて送る
  when 引き上げる

permit プラチナが引き上げる注文(orders_platinum_lifts)
  description "プラチナなら会員が引き上がる注文は、プラチナで送る"
  principal is 会員
  action プラチナで送る
  when 上がる
