gate own_store v1
description "A type named as the type of what reads the entities in every language's code"
namespace Shop

role clerk
  description "Answers requests"
  can reply

principal Store
  description "The one who asks"
  roles clerk
  attributes
    open : bool

resource Ticket
  description "What is asked about"

action reply
  description "Reply to a request"
  principal Store
  resource Ticket

permit clerks_reply
  description "A clerk can: Reply to a request"
  principal in clerk
  action reply
  when principal.open

