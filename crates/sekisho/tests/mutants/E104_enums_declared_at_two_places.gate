gate shop v1
description "Who may look at an order of the shop"
namespace Shop

enum order_status = paid | shipped | returned | refunded
import enum order_status from "read/order_states.rule" -> shared_status

role clerk
  description "Answers customers"
  can view_order

principal User
  description "A member of the staff"
  roles clerk

resource Order
  description "An order of the shop"
  attributes
    status : order_status
    asked  : shared_status

action view_order
  description "Look at an order"
  principal User
  resource Order

permit staff_view_orders_in_the_status_asked
  description "The staff look at an order in the status it is asked for in"
  principal in clerk
  action view_order
  when resource.status is resource.asked
