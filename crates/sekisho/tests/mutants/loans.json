{
  "openapi": "3.1.0",
  "info": { "title": "Loans", "version": "1" },
  "paths": {
    "/loans": {
      "post": {
        "operationId": "openLoan",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": [ "credit_score" ],
          "properties": { "credit_score": { "type": "integer", "minimum": 0, "maximum": 999,
            "x-data-classification": { "category": "PII", "sensitivity": "restricted" } } } } } } },
        "responses": { "201": { "description": "Opened" } }
      }
    }
  }
}
