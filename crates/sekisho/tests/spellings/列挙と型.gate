gate 列挙と型(enum_and_type_ja) v1
description "TypeScript と Python が一つの名前で書く列挙と型"
namespace Shop

enum 注文の状態(order_state) = 低い(low) | 高い(high)

role 係(clerk)
  description "問い合わせに答える"
  can 返信

principal 職員(User)
  description "尋ねる人"
  roles 係
  attributes
    開店(open) : bool

resource 注文(OrderState)
  description "尋ねられるもの"
  attributes
    状態(state) : 注文の状態

action 返信(reply)
  description "問い合わせに返信する"
  principal 職員
  resource 注文

permit 係は返信できる(clerks_reply)
  description "係は次のことができる: 問い合わせに返信する"
  principal in 係
  action 返信
  when resource.状態 is 高い

