gate go_fields v1
description "Two attributes that Go writes as one field of a struct"
namespace Shop

role clerk
  description "Answers requests"
  can reply

principal User
  description "The one who asks"
  roles clerk
  attributes
    open : bool
    order_id : bool
    order__id : bool

resource Ticket
  description "What is asked about"

action reply
  description "Reply to a request"
  principal User
  resource Ticket

permit clerks_reply
  description "A clerk can: Reply to a request"
  principal in clerk
  action reply
  when principal.open

