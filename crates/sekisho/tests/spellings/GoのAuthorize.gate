gate goのauthorize(go_authorize_ja) v1
description "Go のパッケージの、action の名前で引く入口と同じ名前の型"
namespace Shop

role 係(clerk)
  description "問い合わせに答える"
  can 返信

principal 係の人(Clerk)
  description "尋ねる人"
  roles 係

resource 引換券(Authorize)
  description "持つ人が答えをもらえる券"
  attributes
    有効(open) : bool

action 返信(reply)
  description "問い合わせに返信する"
  principal 係の人
  resource 引換券

permit 係は返信できる(clerks_reply)
  description "係は次のことができる: 問い合わせに返信する"
  principal in 係
  action 返信
  when resource.有効
