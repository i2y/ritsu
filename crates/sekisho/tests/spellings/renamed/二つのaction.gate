gate 二つのactionの直し(two_actions_ja_renamed) v1
description "二つのaction.gate の二つ目の別名を、注のとおりに refund_again にしたもの"
namespace Shop

role 係(clerk)
  description "問い合わせに答える"
  can 返金, 再返金

principal 職員(User)
  description "尋ねる人"
  roles 係
  attributes
    開店(open) : bool

resource 問い合わせ(Ticket)
  description "尋ねられるもの"
  attributes
    閉じた(closed) : bool

action 返金(refund_order)
  description "注文を返金する"
  principal 職員
  resource 問い合わせ

action 再返金(refund_again)
  description "注文をもう一度返金する"
  principal 職員
  resource 問い合わせ

permit 係は返金できる(clerks_refund_order)
  description "係は次のことができる: 注文を返金する"
  principal in 係
  action 返金
  when principal.開店

permit 係は再返金できる(clerks_refund_again)
  description "係は次のことができる: 注文をもう一度返金する"
  principal in 係
  action 再返金
  when principal.開店

