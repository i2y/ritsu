gate 入力の型の直し(input_type_ja_renamed) v1
description "入力の型.gate の型の別名を、注のとおりに Ticket にしたもの"
namespace Shop

role 係(clerk)
  description "問い合わせに答える"
  can 返信

principal 職員(User)
  description "尋ねる人"
  roles 係
  attributes
    開店(open) : bool

resource 問い合わせ(Ticket)
  description "尋ねられるもの"
  attributes
    閉じた(closed) : bool

action 返信(reply)
  description "問い合わせに返信する"
  principal 職員
  resource 問い合わせ

permit 係は返信できる(clerks_reply)
  description "係は次のことができる: 問い合わせに返信する"
  principal in 係
  action 返信
  when principal.開店

