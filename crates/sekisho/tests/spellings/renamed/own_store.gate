gate own_store_renamed v1
description "own_store.gate with the type renamed Shopkeeper, as its note says"
namespace Shop

role clerk
  description "Answers requests"
  can reply

principal Shopkeeper
  description "The one who asks"
  roles clerk
  attributes
    open : bool

resource Ticket
  description "What is asked about"

action reply
  description "Reply to a request"
  principal Shopkeeper
  resource Ticket

permit clerks_reply
  description "A clerk can: Reply to a request"
  principal in clerk
  action reply
  when principal.open

