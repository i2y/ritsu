gate 二つのaction(two_actions_ja) v1
description "どの言語でも入力が一つの型になる二つの action"
namespace Shop

role 係(clerk)
  description "問い合わせに答える"
  can 返金, 再返金

principal 職員(User)
  description "尋ねる人"
  roles 係
  attributes
    開店(open) : bool

resource 問い合わせ(Ticket)
  description "尋ねられるもの"
  attributes
    閉じた(closed) : bool

action 返金(refund_order)
  description "注文を返金する"
  principal 職員
  resource 問い合わせ

action 再返金(refund__order)
  description "注文をもう一度返金する"
  principal 職員
  resource 問い合わせ

permit 係は返金できる(clerks_refund_order)
  description "係は次のことができる: 注文を返金する"
  principal in 係
  action 返金
  when principal.開店

permit 係は再返金できる(clerks_refund__order)
  description "係は次のことができる: 注文をもう一度返金する"
  principal in 係
  action 再返金
  when principal.開店

