gate python_literal v1
description "An enum Python writes as Literal, which its module imports"
namespace Shop

enum literal = low | high

role clerk
  description "Answers requests"
  can reply

principal User
  description "The one who asks"
  roles clerk
  attributes
    open : bool

resource Ticket
  description "What is asked about"
  attributes
    priority : literal

action reply
  description "Reply to a request"
  principal User
  resource Ticket

permit clerks_reply
  description "A clerk can: Reply to a request"
  principal in clerk
  action reply
  when principal.open

