gate go_roles v1
description "An attribute that Go writes as the field of the roles of a struct"
namespace Shop

role clerk
  description "Answers requests"
  can reply

principal User
  description "The one who asks"
  roles clerk
  attributes
    open : bool
    roles : bool

resource Ticket
  description "What is asked about"

action reply
  description "Reply to a request"
  principal User
  resource Ticket

permit clerks_reply
  description "A clerk can: Reply to a request"
  principal in clerk
  action reply
  when principal.open

