gate global_date v1
description "A type named as the global Date of TypeScript, and the type of a date of the Go package"
namespace Shop

role clerk
  description "Answers requests"
  can reply

principal Date
  description "The one who asks"
  roles clerk
  attributes
    open : bool

resource Ticket
  description "What is asked about"

action reply
  description "Reply to a request"
  principal Date
  resource Ticket

permit clerks_reply
  description "A clerk can: Reply to a request"
  principal in clerk
  action reply
  when principal.open

