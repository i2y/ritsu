gate pythonのliteral(python_literal_ja) v1
description "Python がモジュールの読み込む Literal と同じ名前で書く列挙"
namespace Shop

enum 水準(literal) = 低い(low) | 高い(high)

role 係(clerk)
  description "問い合わせに答える"
  can 返信

principal 職員(User)
  description "尋ねる人"
  roles 係
  attributes
    開店(open) : bool

resource 問い合わせ(Ticket)
  description "尋ねられるもの"
  attributes
    優先度(priority) : 水準

action 返信(reply)
  description "問い合わせに返信する"
  principal 職員
  resource 問い合わせ

permit 係は返信できる(clerks_reply)
  description "係は次のことができる: 問い合わせに返信する"
  principal in 係
  action 返信
  when principal.開店

