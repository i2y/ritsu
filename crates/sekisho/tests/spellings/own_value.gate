gate own_value v1
description "An enum TypeScript writes as Value, a type of its module"
namespace Shop

enum value = low | high

role clerk
  description "Answers requests"
  can reply

principal User
  description "The one who asks"
  roles clerk
  attributes
    open : bool

resource Ticket
  description "What is asked about"
  attributes
    priority : value

action reply
  description "Reply to a request"
  principal User
  resource Ticket

permit clerks_reply
  description "A clerk can: Reply to a request"
  principal in clerk
  action reply
  when principal.open

