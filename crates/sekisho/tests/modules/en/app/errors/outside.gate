# A path out of the module: lib's file is there on the disk, but app does not ship it, so a user of
# app could not follow the path. A file of a dependency is named `@lib/…`.
gate purchases v1
description "Who approves a purchase, and who receives a delivery into the stock"

use rule approval from "../../lib/rules/approval.rule"
use book stock from "@lib/books/stock.book"

principal User
  attributes
    limit : money[GBP, incl_tax]  range >=0GBP <=50_000GBP

resource Purchase

resource Delivery

action approve
  principal User
  resource Purchase
  input
    amount : money[GBP, incl_tax]  range >=1GBP <=20_000GBP
  context
    band = approval(amount: amount, limit: principal.limit).band

action receive_delivery
  guards stock receive.do
  principal User
  resource Delivery

permit approve_within_the_limit
  principal is User
  action approve
  when band is within_limit

permit users_receive
  principal is User
  action receive_delivery
