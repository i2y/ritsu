dates approval_terms v1
description "A name written wrong where it is declared: it is said once, where it is first used, and the example is not said to leave it out"

inputs
  # the dates and the example still write `received`
  recieved : date  range >=2026-01-01 <=2027-12-31

date reminder = received
  + 2 days
  at 09:00

date due = received
  + 3 days
  at end of day

claims
  reminder_before_due : reminder < due

examples
| received   | -> reminder | -> due     |
| 2026-11-13 | 2026-11-15  | 2026-11-16 |
