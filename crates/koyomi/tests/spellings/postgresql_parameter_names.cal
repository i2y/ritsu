dates postgresql_parameter_names v1
description "Two dates whose aliases share their first 63 bytes and that take the same types under other names. PostgreSQL holds one function for both, and stops at the second, which would change the name of a parameter (W001). Every other target takes them as they are"

inputs
  received      : date  range >=2026-01-01 <=2026-01-31
  days_online   : int   range >=0 <=3
  days_by_phone : int   range >=0 <=3

date the_day_an_order_placed_during_the_spring_campaign_of_2026_ships_online = received
  + days_online days

date the_day_an_order_placed_during_the_spring_campaign_of_2026_ships_by_phone = received
  + days_by_phone days
