dates postgresql_functions_renamed v1
description "The same file as ../postgresql_functions.cal, with the alias the note of its W001 gives; check says nothing, and every target takes it. Its own alias differs from the other file's only so that the two go through the targets side by side"

inputs
  received : date  range >=2026-01-01 <=2026-01-31

date the_day_an_order_placed_during_the_spring_campaign_of_2026_ships_by_post = received
  + 3 days

date the_day_an_order_placed_during_the_spring_campaign_of_2026_ships_by_courier(spring_2026_courier_day) = received
  + 1 day
