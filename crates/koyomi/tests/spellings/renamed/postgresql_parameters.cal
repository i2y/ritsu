dates postgresql_parameters_renamed v1
description "The same file as ../postgresql_parameters.cal, with the alias the note of its W001 gives; check says nothing, and every target takes it. Its own alias differs from the other file's only so that the two go through the targets side by side"

inputs
  received : date  range >=2026-01-01 <=2026-01-31
  days_to_wait_for_an_order_placed_during_the_spring_campaign_of_2026_online   : int  range >=0 <=3
  days_to_wait_for_an_order_placed_during_the_spring_campaign_of_2026_by_phone(spring_2026_phone_days) : int  range >=0 <=3

date ships = received
  + days_to_wait_for_an_order_placed_during_the_spring_campaign_of_2026_online days
  + days_to_wait_for_an_order_placed_during_the_spring_campaign_of_2026_by_phone days
