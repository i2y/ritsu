dates postgresql_parameter_names_renamed v1
description "The same file as ../postgresql_parameter_names.cal, with the alias the note of its W001 gives; check says nothing, and every target takes it. Its own alias differs from the other file's only so that the two go through the targets side by side"

inputs
  received      : date  range >=2026-01-01 <=2026-01-31
  days_online   : int   range >=0 <=3
  days_by_phone : int   range >=0 <=3

date the_day_an_order_placed_during_the_spring_campaign_of_2026_ships_online = received
  + days_online days

date the_day_an_order_placed_during_the_spring_campaign_of_2026_ships_by_phone(spring_2026_phone_ship_day) = received
  + days_by_phone days
