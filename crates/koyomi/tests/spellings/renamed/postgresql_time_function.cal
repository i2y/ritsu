dates postgresql_time_function_renamed v1
description "The same file as ../postgresql_time_function.cal, with the alias the note of its W001 gives; check says nothing, and every target takes it. Its own alias differs from the other file's only so that the two go through the targets side by side"
use calendar "../../fixtures/calendars/weekends.cal"

inputs
  ordered : date  range >=2026-01-01 <=2026-01-31

date the_last_moment_to_cancel_an_order_placed_in_the_spring_campaign_of_2026(spring_2026_cancel_by) = ordered
  + 2 business days
  at 12:00
