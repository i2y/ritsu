dates civil_code_month_end v1
description "Breaks its claims on purpose. Article 143 of the Civil Code ends a period of months on the day before the day of the last month that corresponds to the first day, and on the last day of that month when it has no such day; by Article 140 the first day is the day after the event. Rounding down to the end of the month and then taking the day before ends the period a day early when the month has no such day, and counting the months from the day of the event ends it early almost always, by up to four days"

inputs
  origin      : date  range >=2026-01-01 <=2026-12-31
  month_count : int   range >=1 <=12

date first_day = origin
  + 1 day                                        # the day itself is not counted
date last_day = first_day
  + month_count months else start_of_next_month  # the corresponding day of the last month; with none, the 1st of the month after
  - 1 day                                        # the day before it: the last day of the last month when it had no corresponding day
date rounded_down = first_day
  + month_count months else end_of_month         # the corresponding day; with none, the end of the month
  - 1 day                                        # the day before it: a day early when the month had no corresponding day
date from_the_event = origin
  + month_count months else start_of_next_month  # the months counted from the day of the event, not from the first day
  - 1 day

claims
  rounding_down_first     : last_day = rounded_down
  counting_from_the_event : last_day = from_the_event
