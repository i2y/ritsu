dates payment v1
description "Closes on the 20th; pays on the 10th of the next month, or on the business day before when that day is closed. This version takes the months to the payment as an input. The days are the example's own"
use calendar "office.cal"

inputs
  received : date  range >=2026-01-01 <=2026-08-31
  payment_month : int  range >=1 <=2

date closing = received
  close day 20

date payment = closing
  day 10 of month +payment_month
  roll preceding
