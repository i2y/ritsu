dates eom_close_two_months_later v1
description "Closes at the end of the month; pays at the end of the month two months later, or on the business day before when that day is closed. The English version of eom_close_two_months_later.ja.cal. It breaks the claim within_60_days_of_receipt on purpose: the claim is this example's own, written as it reads, and does not say how any law is read"
use calendar "calendars/tokyo_business_days.cal"

inputs
  received : date  range >=2026-01-01 <=2027-10-31

date closing = received
  close end of month    # "closes at the end of the month"

date payment = closing
  end of month +2       # "pays at the end of the month two months later"
  roll preceding        # "on the business day before when that day is closed"

claims
  within_60_days_of_receipt : payment <= received + 60 days
