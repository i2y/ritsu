/target/
# TigerBeetle's release binary, fetched by tools/tigerbeetle/fetch.sh
/tools/tigerbeetle/tigerbeetle
/tools/tigerbeetle/*.zip
# MySQL's build, fetched by tools/mysql/fetch.sh
/tools/mysql/mysql/
# what the runners install: `npm ci --prefix tools/runner`, and the venv of tools/runner/requirements.txt
/tools/runner/node_modules/
/tools/runner/.venv/
# a build of the Rust runner made in its own directory (the tests build it in the target directory)
/tools/runner/rust/target/
# Mermaid, for tests/doc.rs: `npm ci --prefix tools/mermaid`
/tools/mermaid/node_modules/
__pycache__/
