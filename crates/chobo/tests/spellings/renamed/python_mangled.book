book python_mangled_renamed v1
description "python_mangled.book with _adjust renamed adjust, as its note says"

unit pcs

account stock(sku: string) : pcs
  at least 0 refused as out_of_stock
account suppliers : pcs outside
account customers : pcs outside

transfer receive(delivery: string, sku: string, qty: pcs)
  key delivery, sku
  move qty from suppliers to stock(sku)

transfer ship(order: string, sku: string, qty: pcs)
  key order, sku
  move qty from stock(sku) to customers

transfer adjust(count: string, sku: string, qty: pcs)
  key count, sku
  move qty from suppliers to stock(sku)
