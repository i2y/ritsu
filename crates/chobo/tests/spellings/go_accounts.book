book go_accounts v1
description "Two accounts whose names differ only in the case of their first letter, which the Go client writes alike"

unit pcs

account stock(sku: string) : pcs
  at least 0 refused as out_of_stock
account Stock : pcs outside
account customers : pcs outside

transfer receive(delivery: string, sku: string, qty: pcs)
  key delivery, sku
  move qty from Stock to stock(sku)

transfer ship(order: string, sku: string, qty: pcs)
  key order, sku
  move qty from stock(sku) to customers
