book changes v1
unit item

account stock(sku: string) : item
  at least 0 refused as out_of_stock
account returns_shelf(sku: string) : item
  at least 0 refused as returns_shelf_empty
account supplier : item outside
account customer : item outside

transfer receive(slip: string, sku: string, qty: item)
  key slip, sku
  move qty from supplier to stock(sku)
transfer reserve(order: string, sku: string, qty: item)
  key order, sku
  pending expires after 30 minutes
  move qty from stock(sku) to customer
transfer take_back(slip: string, sku: string, qty: item)
  key slip
  move qty from customer to returns_shelf(sku)
transfer restock(slip: string, sku: string, qty: item)
  key slip
  move qty from returns_shelf(sku) to stock(sku)
