# E062: a name in MySQL is 64 characters at most; the tables and checks are named after the book, and `_within_lower` makes the longest of them
book stock_of_the_central_warehouse_and_of_each_branch_stores v1

unit item

account stock(sku: string) : item
  at least 0 refused as out_of_stock
account supplier : item outside
account customer : item outside

transfer receive(slip: string, sku: string, qty: item)
  key slip, sku
  move qty from supplier to stock(sku)

transfer ship(order: string, sku: string, qty: item)
  key order, sku
  move qty from stock(sku) to customer
