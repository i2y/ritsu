# W105: a unit, an account and a parameter that nothing uses
book unused v1
unit item
unit box

account stock(sku: string) : item
  at least 0 refused as out_of_stock
account returns_shelf(sku: string) : item
  at least 0 refused as returns_shelf_empty
account supplier : item outside
account customer : item outside

transfer receive(slip: string, sku: string, qty: item, staff: string)
  key slip
  move qty from supplier to stock(sku)
transfer ship(order: string, sku: string, qty: item)
  key order
  move qty from stock(sku) to customer
