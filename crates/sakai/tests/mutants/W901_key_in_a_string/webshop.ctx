map Webshop(webshop) v1
description "Four services of a small shop that talk over HTTP and events, each with its contract; the staging maps key is AIzaSyD-ritsu-fake-key-for-tests-000000"

use context "contexts/ordering.ctx"
use context "contexts/payments.ctx"
use context "contexts/shipping.ctx"
use context "contexts/notifications.ctx"

covers "."
