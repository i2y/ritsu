# コピー元: dandori の examples/fulfillment/temporal/fulfillment.ja.flow。規則を Connect で呼ぶようにし、proto と子の .flow の
# パスをこの例の置き場所に、在庫の値の名前を stock.proto のものに直し、明細に在庫を押さえる ID を持たせ、押さえたあとの失敗では戻して注文を取り消し、明細の食い違いを在庫不足と分け、梱包が済んだら確定する
workflow 引当と発送 v1 implements 店.FulfillmentService
description "注文の明細ごとに在庫を引き当て、配送を手配し、倉庫の梱包を待ち、引き当てたぶんを確定してから、お客さまに知らせる。明細は並べて引き当て、足りない明細があるときも、引き当てたあとで失敗したときも、引き当てたぶんを戻し、注文を取り消す。Temporal 向けの版：倉庫の呼び出しは dandori が Connect で生成するアクティビティ。配送チームのワークフローが専用のタスクキューで配送を手配し（子ワークフロー、配送の手配.flow）、翌日便の車がなければ通常便で頼み直す。梱包の依頼、お知らせ、記録は自分で書くアクティビティで、梱包の担当者は、生成したクライアントが送る Update でコールバックに応答する"

use rule 急ぎ from "../delivery/rules/出荷の急ぎ.rule"
use proto 店 from "../proto/shop/ordering/v1/fulfillment.proto"
use proto warehouse from "../proto/warehouse/v1/stock.proto"
  url "https://warehouse.example.com"
use proto 受注 from "../proto/shop/ordering/v1/order.proto"
  url "https://orders.example.com"

record 明細
  id  : string
  sku : string
  数  : int  range >=0 <=1000000

record 贈り物
  宛名       : string
  メッセージ : string?

record 注文
  id     : string
  会員   : bool
  金額   : money[円, incl_tax]  range >=0 <=1000000
  明細   : list[明細]
  贈り物 : 贈り物?
  付帯   : json

record 配送
  追跡番号 : string

record 梱包の依頼
  注文ID : string
  引当   : list[warehouse.ReserveResponse]

record 梱包
  箱の数 : int

inputs
  注文 : 注文

outputs
  引当     : list[warehouse.ReserveResponse]
  追跡番号 : string

# 倉庫は、どの引当にも答える。在庫を押さえられたら STOCK_SECURED とその ID、足りなければ STOCK_SHORT、同じ明細を
# 違う中身で押さえようとしたら STOCK_CONFLICT。確定すると、その押さえは取り消せなくなる。
task 在庫を引き当てる(line_id: string, sku: string, quantity: int  range >=0 <=1000000) -> warehouse.ReserveResponse
  connect warehouse "StockService/Reserve"
  errors 混雑 = resource_exhausted
  key
  retry 2 times every 1 second on 混雑

task 引当を戻す(id: string)
  connect warehouse "StockService/Release"
  idempotent

task 引当を確定する(id: string)
  connect warehouse "StockService/Post"
  idempotent

# この実行があきらめた注文は取り消す。請求は注文の状態を読み（請求の要否.rule）、取り消した注文は
# 請求しない。
task 注文を取り消す(id: string)
  connect 受注 "OrderService/CancelOrder"
  idempotent

# 配送チームのワークフローが、専用のタスクキューのワーカーで配送を手配する。それ自身の .flow で
# 書いてあり、検査はこのタスクを、その入力・出力・エラーと突き合わせる。
task 配送を手配する(注文ID: string, 便: 急ぎ.便, 宛名: string?, 付帯: json) -> 配送
  flow "../delivery/配送の手配.flow"
  errors 翌日便の空きなし

# 梱包の担当者のアプリは、自分で書く関数から依頼とコールバックの ID を受け取り、箱詰めが
# 済むとコールバックに応答する。
task 梱包を待つ(注文ID: string, 引当: list[warehouse.ReserveResponse]) -> 梱包
  callback
  errors 欠品
  timeout 2 days

# お店の通知サービス。
task 知らせる(注文ID: string, 本文: string)
  errors 宛先なし

task 記録する(注文ID: string, 付帯: json)
  idempotent

flow
  let 判定 = 急ぎ(会員: 注文.会員, 金額: 注文.金額)
  let 結果 = for 明細 in 注文.明細 at most 50 in parallel, 10 at a time
    let 答え = 在庫を引き当てる(line_id: 明細.id, sku: 明細.sku, quantity: 明細.数)
    yield 答え
  let 足りない = false
  let 食い違い = false
  for 一つ in 結果 at most 50
    match 一つ.stock
      STOCK_SHORT => let 足りない = true
      STOCK_CONFLICT => let 食い違い = true
      STOCK_SECURED => pass
  match 食い違い
    true =>
      for 戻す in 結果 at most 50 in parallel
        match 戻す.id
          some id => 引当を戻す(id: id)
          none => pass
      注文を取り消す(id: 注文.id)
      fail 明細の食い違い "注文 {注文.id} には、前に別の sku や数で押さえた明細があります"
    false => pass
  match 足りない
    true =>
      for 戻す in 結果 at most 50 in parallel
        match 戻す.id
          some id => 引当を戻す(id: id)
          none => pass
      注文を取り消す(id: 注文.id)
      fail 在庫不足 "注文 {注文.id} には在庫の足りない明細があります"
    false => pass
  let 宛名: string? = none
  match 注文.贈り物
    some 贈り物 =>
      let 宛名 = 贈り物.宛名
      match 贈り物.メッセージ
        some 一言 => 記録する(注文ID: 注文.id, 付帯: {メッセージ: 一言, 宛名: 贈り物.宛名})
        none => pass
    none => pass
  let 配送 = 配送を手配する(注文ID: 注文.id, 便: 判定.便, 宛名: 宛名, 付帯: 注文.付帯)
    on 翌日便の空きなし =>
      let 配送 = 配送を手配する(注文ID: 注文.id, 便: 通常便, 宛名: 宛名, 付帯: 注文.付帯)
        on failure =>
          for 戻す in 結果 at most 50 in parallel
            match 戻す.id
              some id => 引当を戻す(id: id)
              none => pass
          注文を取り消す(id: 注文.id)
          fail 配送の手配の失敗 "注文 {注文.id} の配送を手配できませんでした"
    on failure =>
      for 戻す in 結果 at most 50 in parallel
        match 戻す.id
          some id => 引当を戻す(id: id)
          none => pass
      注文を取り消す(id: 注文.id)
      fail 配送の手配の失敗 "注文 {注文.id} の配送を手配できませんでした"
  let 箱 = 梱包を待つ(注文ID: 注文.id, 引当: 結果)
    on timeout =>
      for 戻す in 結果 at most 50 in parallel
        match 戻す.id
          some id => 引当を戻す(id: id)
          none => pass
      注文を取り消す(id: 注文.id)
      fail 梱包の遅れ "二日たっても梱包の知らせがありません"
    on 欠品 =>
      for 戻す in 結果 at most 50 in parallel
        match 戻す.id
          some id => 引当を戻す(id: id)
          none => pass
      注文を取り消す(id: 注文.id)
      fail 梱包の欠品 "注文 {注文.id} の梱包の途中で品が足りなくなりました。受注に戻します"
  for 押さえた in 結果 at most 50 in parallel
    match 押さえた.id
      some id => 引当を確定する(id: id)
      none => pass
  知らせる(注文ID: 注文.id, 本文: "注文 {注文.id} を{判定.便}で出しました（{箱.箱の数} 箱、追跡番号 {配送.追跡番号}）")
    on 宛先なし => pass
  succeed 引当 = 結果, 追跡番号 = 配送.追跡番号
