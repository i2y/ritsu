rule shipping_fee v1
description "The shipping fee with the surcharge of delivery expanded into it. Written for the mutant"

inputs
  parcel_weight : number  range >=0 <=100

outputs
  fee : money[JPY, incl_tax]  round down(1JPY)

apply surcharge = "../../delivery/rules/surcharge.rule" sha256:d412cf576db77d00
  weight = parcel_weight
  surcharge -> surcharge_amount

define fee_calculation : money[JPY, incl_tax] = surcharge_amount + 800JPY

result fee = fee_calculation
