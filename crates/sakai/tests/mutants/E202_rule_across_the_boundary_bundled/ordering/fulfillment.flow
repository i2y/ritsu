# Copied from dandori's examples/fulfillment/temporal/fulfillment.flow. The rule is called by Connect, the paths of the
# protos and of the child .flow are those of this example's layout, the names of the inventory's values are those of stock.proto, each line has an id its stock is held under, a failure after the hold gives it back, and the packing is posted when it is done
workflow fulfillment v1 implements shop.FulfillmentService
description "Reserve stock for each line of an order, arrange the delivery, wait for the warehouse to pack it, post what was reserved, and then tell the customer. The lines are reserved side by side, and when one is short, or anything fails after the stock was reserved, what was reserved is released. Written for Temporal: the warehouse's calls are activities dandori writes, by Connect; a workflow of the delivery team, on its own task queue, arranges the delivery (a child workflow, arrange_delivery.flow), and when it finds no next-day van the standard carrier is asked; and the packing request, the notice and the audit log are activities you write, the packing crew answering the callback by the update the generated client sends"

use rule urgency from "../delivery/rules/urgency.rule"
use proto shop from "../proto/shop/ordering/v1/fulfillment.proto"
use proto warehouse from "../proto/warehouse/v1/stock.proto"
  url "https://warehouse.example.com"

record Line
  id       : string
  sku      : string
  quantity : int  range >=0 <=1000000

record Gift
  recipient : string
  message   : string?

record Order
  id     : string
  member : bool
  amount : money[JPY, incl_tax]  range >=0 <=1000000
  lines  : list[Line]
  gift   : Gift?
  extra  : json

record Delivery
  tracking_number : string

record PackingRequest
  order_id     : string
  reservations : list[warehouse.ReserveResponse]

record Packing
  boxes : int

inputs
  order : Order

outputs
  reservations    : list[warehouse.ReserveResponse]
  tracking_number : string

# The warehouse answers every reservation: STOCK_SECURED with its id, STOCK_SHORT when the stock is short, or
# STOCK_CONFLICT when the line was reserved before with other stock. Posting makes a reservation final.
task reserve_stock(line_id: string, sku: string, quantity: int  range >=0 <=1000000) -> warehouse.ReserveResponse
  connect warehouse "StockService/Reserve"
  errors busy = resource_exhausted
  key
  retry 2 times every 1 second on busy

task release_stock(id: string)
  connect warehouse "StockService/Release"
  idempotent

task post_stock(id: string)
  connect warehouse "StockService/Post"
  idempotent

# The delivery team's workflow arranges the delivery, on the workers of its own task queue. It is
# written as a .flow of its own, and the checker holds this task to its inputs, outputs and errors.
task arrange_delivery(order_id: string, carrier: urgency.carrier, recipient: string?, extra: json) -> Delivery
  flow "../delivery/arrange_delivery.flow"
  errors NoVan

# The packing crew's app gets the request and the callback's id from the function you write,
# and answers the callback when the boxes are packed.
task wait_for_packing(order_id: string, reservations: list[warehouse.ReserveResponse]) -> Packing
  callback
  errors short
  timeout 2 days

# The shop's own notice service.
task notify(order_id: string, text: string)
  errors no_recipient

task audit(order_id: string, extra: json)
  idempotent

flow
  let decision = urgency(member: order.member, amount: order.amount)
  let results = for line in order.lines at most 50 in parallel, 10 at a time
    let r = reserve_stock(line_id: line.id, sku: line.sku, quantity: line.quantity)
    yield r
  let any_short = false
  for one in results at most 50
    match one.stock
      STOCK_SHORT, STOCK_CONFLICT => let any_short = true
      STOCK_SECURED => pass
  match any_short
    true =>
      for taken in results at most 50 in parallel
        match taken.id
          some id => release_stock(id: id)
          none => pass
      fail OutOfStock "Order {order.id} has lines the stock is short of"
    false => pass
  let recipient: string? = none
  match order.gift
    some gift =>
      let recipient = gift.recipient
      match gift.message
        some words => audit(order_id: order.id, extra: {message: words, recipient: gift.recipient})
        none => pass
    none => pass
  let delivery = arrange_delivery(order_id: order.id, carrier: decision.carrier, recipient: recipient, extra: order.extra)
    on NoVan =>
      let delivery = arrange_delivery(order_id: order.id, carrier: standard, recipient: recipient, extra: order.extra)
        on failure =>
          for taken in results at most 50 in parallel
            match taken.id
              some id => release_stock(id: id)
              none => pass
          fail DeliveryFailed "Could not arrange the delivery of order {order.id}"
    on failure =>
      for taken in results at most 50 in parallel
        match taken.id
          some id => release_stock(id: id)
          none => pass
      fail DeliveryFailed "Could not arrange the delivery of order {order.id}"
  let packed = wait_for_packing(order_id: order.id, reservations: results)
    on timeout =>
      for taken in results at most 50 in parallel
        match taken.id
          some id => release_stock(id: id)
          none => pass
      fail PackingLate "No word of the packing in two days"
    on short =>
      for taken in results at most 50 in parallel
        match taken.id
          some id => release_stock(id: id)
          none => pass
      fail PackingShort "The warehouse found an item missing while packing order {order.id}. It goes back to ordering"
  for held in results at most 50 in parallel
    match held.id
      some id => post_stock(id: id)
      none => pass
  notify(order_id: order.id, text: "Order {order.id} went out by {decision.carrier} ({packed.boxes} boxes, tracking number {delivery.tracking_number})")
    on no_recipient => pass
  succeed reservations = results, tracking_number = delivery.tracking_number
