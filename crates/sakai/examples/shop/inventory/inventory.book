# Copied from chobo's examples/inventory/inventory.book. A line of an order is held (not the order and the SKU), and the
# hold lasts 14 days, longer than the two days the packing crew has to answer and than the seven days from the order to
# the shipping day (delivery/ship_date.cal).
# Stock held for a line of an order: within 14 days it ships or is cancelled.
book inventory v1
description "Stock per SKU. A delivery adds to it, an order holds what each line takes for 14 days, shipping posts the hold, cancelling voids it, and a return puts the goods back on the shelves"

unit pcs

account stock(sku: string) : pcs
  description "what is on the shelves"
  at least 0 refused as out_of_stock
account suppliers : pcs outside
account customers : pcs outside

transfer receive(delivery: string, sku: string, qty: pcs)
  key delivery, sku
  move qty from suppliers to stock(sku)

transfer reserve(line: string, sku: string, qty: pcs)
  description "posted when the order ships, voided when it is cancelled"
  key line
  pending expires after 14 days
  move qty from stock(sku) to customers

transfer take_back(return_id: string, sku: string, qty: pcs)
  description "what a customer sent back, on the shelves again"
  key return_id, sku
  move qty from customers to stock(sku)
