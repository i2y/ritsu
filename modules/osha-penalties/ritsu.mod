# The most OSHA may propose for a violation, as a rule of rulec that pins the section it reads. A new
# version follows each January's amendment of the amounts.
module ghcr.io/i2y/ritsu-osha-penalties
version 1.1.0
description "The most OSHA may propose for a violation, and the least for a willful one, as a rule of rulec that follows each year's amendment"
ritsu >=0.41.0
license "MIT OR Apache-2.0"
source "https://github.com/i2y/ritsu"
